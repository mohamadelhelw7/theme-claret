{%- comment -%}
  Painting hero: a painting (or your photo or video) fills the hero and drifts very slowly, with the
  headline at the top and a small credit for the painting. Along the bottom third (or half), a strip of
  small paintings from a collection drifts past. Shoppers drag it to browse; a round cursor follows the
  mouse, the strip loops forever, and pointing at a painting shows its title. On phones it swipes.
{%- endcomment -%}

{%- liquid
  assign hero_media = false
  if section.settings.video != blank or section.settings.image != blank or section.settings.image_mobile != blank
    assign hero_media = true
  endif
  assign strip_count = section.settings.limit
  assign strip_collection = section.settings.collection
  assign heading_id = 'FolioHeroHeading-' | append: section.id
  assign fit_class = ''
  if section.settings.height == 'adapt' or section.settings.height == 'ratio'
    assign fit_class = ' hero-fit'
  endif
-%}

<section data-align="{{ section.settings.sec_text_align }}" data-pad-box
  class="fhero fhero--{{ section.settings.strip_size }} fhero--{{ section.settings.height }}{{ fit_class }} color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --hero-h: {{ section.settings.standard_height | divided_by: 100.0 }}; --head-scale: {{ section.settings.heading_size | divided_by: 100.0 }}; --text-scale: {{ section.settings.text_size | divided_by: 100.0 }}; --strip-scale: {{ section.settings.strip_art_size | divided_by: 100.0 }};{% if fit_class != blank %} {% render 'hero-ratio', mode: section.settings.height, ratio: section.settings.aspect_ratio, ratio_mobile: section.settings.aspect_ratio_mobile, video: section.settings.video, image: section.settings.image, image_2: section.settings.image_2, image_mobile: section.settings.image_mobile %}{% endif %}"
  aria-labelledby="{{ heading_id }}"
  data-no-reveal
>
  <div class="fhero__media{% if section.settings.drift %} fhero__media--drift{% endif %}">
    {%- if hero_media -%}
      {% render 'hero-media',
        video: section.settings.video,
        image: section.settings.image,
        image_2: section.settings.image_2,
        image_mobile: section.settings.image_mobile,
        alt: section.settings.credit,
        sizes: '100vw'
      %}
    {%- else -%}
      {% render 'media-placeholder', kind: 'hero' %}
    {%- endif -%}
  </div>
  <span class="fhero__shade" aria-hidden="true"></span>

  <div class="fhero__top page-width">
    <div class="fhero__copy">
      {%- if section.settings.heading != blank -%}
        <h2 id="{{ heading_id }}" class="fhero__heading">{% render 'accent-text', text: section.settings.heading %}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="fhero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="fhero__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.credit != blank -%}
      <p class="fhero__credit">{% render 'accent-text', text: section.settings.credit %}</p>
    {%- endif -%}
  </div>

  {%- if section.settings.show_strip -%}
    <art-strip class="fhero__band" data-speed="{{ section.settings.speed }}" tabindex="0" aria-label="{{ 'sections.hero.strip_label' | t }}">
      {%- if section.settings.band_label != blank -%}
        <span class="fhero__band-label page-width" aria-hidden="true"><b>{{ section.settings.band_label | escape }}</b></span>
      {%- endif -%}
      <div class="fhero__track" data-track>
        {%- for pass in (1..2) -%}
          {%- if strip_collection != blank and strip_collection.products.size > 0 -%}
            {%- for product in strip_collection.products limit: strip_count -%}
              {%- assign item_ratio = product.featured_media.aspect_ratio | default: 0.8 -%}
              <a
                class="fhero__item"
                href="{{ product.url }}"
                style="--r: {{ item_ratio }};"
                draggable="false"
                {% if pass == 2 %}
                  aria-hidden="true" tabindex="-1"
                {% endif %}
              >
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 300, 400, 600', sizes: '240px', alt: '', draggable: 'false' }}
                {%- else -%}
                  {% render 'painting-art', variant: forloop.index %}
                {%- endif -%}
                <span class="fhero__caption"><i>{{ product.title | escape }}</i>{%- if product.vendor != blank and product.vendor != shop.name -%}<span>{{ product.vendor | escape }}</span>{%- endif -%}</span>
              </a>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..8) -%}
              {%- liquid
                assign ph_variant = i | modulo: 4 | plus: 1
                assign ph_ratio = 0.8
                if ph_variant == 1
                  assign ph_ratio = 1.3
                elsif ph_variant == 4
                  assign ph_ratio = 0.9
                endif
              -%}
              <span
                class="fhero__item"
                style="--r: {{ ph_ratio }};"
                {% if pass == 2 %}
                  aria-hidden="true"
                {% endif %}
              >
                {% render 'painting-art', variant: ph_variant %}
              </span>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <span class="fhero__cursor" aria-hidden="true"><b>‹</b><b>›</b></span>
    </art-strip>
  {%- endif -%}
</section>

{% javascript %}
  if (!customElements.get('art-strip')) {
    class ArtStrip extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.cursor = this.querySelector('.fhero__cursor');
        this.items = Array.from(this.track.children);
        this.still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.speed = (Number(this.dataset.speed) || 0) / 100;
        this.x = 0;
        this.v = 0;
        this.half = 0;
        this.frames = 0;
        this.dragging = false;
        this.visible = true;
        this.measure = () => {
          this.half = this.track.scrollWidth / 2;
        };
        this.onDown = (e) => {
          if (e.button && e.button !== 0) return;
          this.dragging = true;
          this.moved = 0;
          this.lastX = e.clientX;
          this.v = 0;
          this.classList.add('is-dragging');
          this.setPointerCapture?.(e.pointerId);
        };
        this.onMove = (e) => {
          const box = this.getBoundingClientRect();
          this.cursor.style.translate = `${e.clientX - box.left}px ${e.clientY - box.top}px`;
          if (!this.dragging) return;
          const dx = e.clientX - this.lastX;
          this.lastX = e.clientX;
          this.moved += Math.abs(dx);
          this.x += dx;
          this.v = -dx;
        };
        this.onUp = () => {
          this.dragging = false;
          this.classList.remove('is-dragging');
        };
        // A drag should not open the painting under the pointer
        this.onClick = (e) => {
          if (this.moved > 6) {
            e.preventDefault();
            this.moved = 0;
          }
        };
        this.onKey = (e) => {
          if (e.key === 'ArrowRight') this.v = 9;
          if (e.key === 'ArrowLeft') this.v = -9;
        };
        this.addEventListener('pointerdown', this.onDown);
        this.addEventListener('pointermove', this.onMove);
        this.addEventListener('pointerup', this.onUp);
        this.addEventListener('pointercancel', this.onUp);
        this.addEventListener('pointerenter', () => this.classList.add('is-pointing'));
        this.addEventListener('pointerleave', () => {
          this.classList.remove('is-pointing');
          this.onUp();
        });
        this.addEventListener('click', this.onClick, true);
        this.addEventListener('keydown', this.onKey);
        window.addEventListener('resize', this.measure, { passive: true });
        if ('IntersectionObserver' in window) {
          this.io = new IntersectionObserver((entries) => {
            this.visible = entries[0].isIntersecting;
          });
          this.io.observe(this);
        }
        this.tick = this.tick.bind(this);
        this.raf = requestAnimationFrame(this.tick);
      }

      disconnectedCallback() {
        cancelAnimationFrame(this.raf);
        window.removeEventListener('resize', this.measure);
        this.io?.disconnect();
      }

      tick() {
        this.raf = requestAnimationFrame(this.tick);
        if (!this.visible) return;
        if (!this.half || this.frames++ % 40 === 0) this.measure();
        if (!this.dragging) {
          this.x -= (this.still ? 0 : this.speed) + this.v;
          this.v *= 0.94;
          if (Math.abs(this.v) < 0.01) this.v = 0;
        }
        if (this.half) {
          while (this.x <= -this.half) this.x += this.half;
          while (this.x > 0) this.x -= this.half;
        }
        this.track.style.transform = `translateX(${this.x}px)`;
      }
    }
    customElements.define('art-strip', ArtStrip);
  }
{% endjavascript %}

{% stylesheet %}
  .fhero {
    position: relative;
    overflow: hidden;
    background: #1d1d1b;
    color: #f6f5f3;
  }
  .fhero--standard {
    height: calc(var(--d) * 40 * var(--hero-h, 1));
    min-height: 460px;
  }
  .fhero--full {
    height: 100svh;
    min-height: 560px;
  }
  .fhero--large {
    height: 86svh;
    min-height: 540px;
  }
  .fhero--medium {
    height: 70svh;
    min-height: 500px;
  }
  .fhero.hero-fit {
    min-height: 520px !important;
  }
  .fhero__media {
    position: absolute;
    inset: 0;
  }
  .fhero__media > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .fhero__media img,
  .fhero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fhero__media--drift > * {
      animation: fhero-drift 26s ease-in-out infinite alternate;
    }
  }
  @keyframes fhero-drift {
    from {
      scale: 1.02;
      translate: 0 0;
    }
    to {
      scale: 1.1;
      translate: -2% -1.5%;
    }
  }
  .fhero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(10 10 10 / calc(var(--overlay) * 0.9)),
      rgb(10 10 10 / calc(var(--overlay) * 0.18)) 30%,
      rgb(10 10 10 / 0) 46%,
      rgb(10 10 10 / calc(var(--overlay) * 0.6)) 62%,
      rgb(10 10 10 / calc(var(--overlay) * 1.4)) 100%
    );
  }
  .fhero__top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: calc(var(--d) * 2);
    padding-top: calc(var(--d) * 3.2);
  }
  .fhero__copy {
    display: grid;
    justify-items: start;
    gap: calc(var(--d) * 1.2);
    max-width: calc(var(--d) * 46);
  }
  .fhero__heading {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: calc(var(--d) * 4.6 * var(--heading-scale, 1) * var(--sec-h, 1) * var(--head-scale, 1));
    line-height: 0.9;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .fhero__heading em {
    display: block;
    font-style: italic;
  }
  .fhero__text {
    max-width: 30em;
    font-size: calc(1em * var(--text-scale, 1));
    color: rgb(246 245 243 / 0.88);
  }
  .fhero__link {
    padding-bottom: 0.2em;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: calc(var(--d) * 0.84 * var(--text-scale, 1));
    text-decoration: none;
  }
  .fhero__credit {
    margin: calc(var(--d) * 0.4) 0 0;
    font-size: calc(var(--d) * 0.72 * var(--text-scale, 1));
    color: rgb(246 245 243 / 0.82);
    text-align: end;
  }
  .fhero__credit em {
    font-family: var(--font-heading);
    font-size: 1.2em;
  }

  /* The strip of small paintings along the bottom */
  .fhero__band {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
    height: 33.4%;
    min-height: 170px;
    cursor: none;
    touch-action: pan-y;
    outline: none;
  }
  .fhero--half .fhero__band {
    height: 50%;
    min-height: 240px;
  }
  .fhero__band:focus-visible {
    box-shadow: inset 0 0 0 2px #f6f5f3;
  }
  .fhero__band-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }
  .fhero__band-label::before {
    content: '';
    display: block;
    border-top: 1px solid rgb(246 245 243 / 0.28);
  }
  .fhero__band-label b {
    display: inline-block;
    padding-top: 0.9em;
    font-size: calc(var(--d) * 0.66 * var(--text-scale, 1));
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(246 245 243 / 0.7);
  }
  .fhero__track {
    position: absolute;
    left: 0;
    bottom: calc(var(--d) * 1.4);
    display: flex;
    align-items: flex-end;
    gap: calc(var(--d) * 2.4);
    height: min(calc(var(--d) * 7.4 * var(--strip-scale, 1)), 80%);
    padding-inline: var(--gutter);
    will-change: transform;
  }
  .fhero--half .fhero__track {
    height: min(calc(var(--d) * 11.4 * var(--strip-scale, 1)), 85%);
  }
  .fhero__item {
    position: relative;
    flex: none;
    display: block;
    height: 100%;
    aspect-ratio: var(--r, 0.8);
    color: inherit;
    text-decoration: none;
    user-select: none;
  }
  .fhero__item img,
  .fhero__item .painting-art {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--d) * 0.2);
    box-shadow: 0 calc(var(--d) * 0.8) calc(var(--d) * 1.6) calc(var(--d) * -0.8) rgb(0 0 0 / 0.8), 0 calc(var(--d) * 0.15) calc(var(--d) * 0.4) rgb(0 0 0 / 0.35);
    pointer-events: none;
    transition: translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fhero__caption {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--d) * 0.8);
    display: grid;
    justify-items: center;
    gap: 0.1em;
    width: max-content;
    max-width: 260px;
    font-size: calc(var(--d) * 0.72 * var(--text-scale, 1));
    color: rgb(246 245 243 / 0.82);
    text-align: center;
    translate: -50% 6px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, translate 0.3s ease;
  }
  .fhero__caption i {
    font-family: var(--font-heading);
    font-size: 1.45em;
    line-height: 1.1;
    color: #f6f5f3;
  }
  @media (hover: hover) {
    .fhero__item:hover img {
      translate: 0 -6px;
    }
    .fhero__item:hover .fhero__caption {
      opacity: 1;
      translate: -50% 0;
    }
  }
  .fhero__cursor {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 72px;
    height: 72px;
    margin: -36px 0 0 -36px;
    border-radius: 50%;
    background: rgb(250 249 247 / 0.94);
    box-shadow: 0 0 0 5px rgb(250 249 247 / 0.22);
    color: #4a4a4a;
    font-size: calc(1.1rem * var(--sec-t, 1));
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition: opacity 0.25s ease, scale 0.25s ease;
  }
  .fhero__band.is-pointing .fhero__cursor {
    opacity: 1;
    scale: 1;
  }
  .fhero__band.is-dragging .fhero__cursor {
    scale: 0.86;
  }
  @media (hover: none) {
    .fhero__band {
      cursor: auto;
    }
    .fhero__cursor {
      display: none;
    }
  }
  @media (max-width: 749px) {
    .fhero__top {
      flex-direction: column;
    }
    .fhero__credit {
      display: none;
    }
    .fhero__band {
      min-height: 150px;
    }
    .fhero--standard {
      height: calc(var(--d) * 30 * var(--hero-h, 1));
      min-height: 420px;
    }
    .fhero__top {
      padding-top: calc(var(--d) * 2);
    }
    .fhero__heading {
      font-size: calc(var(--d) * 2.5 * var(--heading-scale, 1) * var(--sec-h, 1) * var(--head-scale, 1));
    }
    .fhero__track {
      bottom: calc(var(--d) * 1.1);
      gap: calc(var(--d) * 1);
      height: min(calc(var(--d) * 6.4 * var(--strip-scale, 1)), 80%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Painting hero",
  "tag": "div",
  "class": "folio-hero-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Painting or photo",
      "info": "A painting filling the hero, or any wide photo"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second photo",
      "info": "Optional. Shows beside the first, so the hero holds two photos"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Phone image",
      "info": "Optional, shown on phones instead"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop instead of the image"
    },
    {
      "type": "checkbox",
      "id": "drift",
      "label": "Let the background drift slowly",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Shade for the text",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "text",
      "id": "credit",
      "label": "Credit for the painting",
      "info": "Shown small at the top. Wrap the title in *asterisks* to set it in italics.",
      "default": "Vincent van Gogh · *Wheat Field with Cypresses*, 1889"
    },
    {
      "type": "header",
      "content": "Height"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "adapt",
          "label": "Follow the image's shape"
        },
        {
          "value": "ratio",
          "label": "Choose a ratio"
        }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "standard_height",
      "label": "Standard height",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ section.settings.height == 'standard' }}"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Ratio",
      "info": "Used when the height is Choose a ratio",
      "options": [
        {
          "value": "2.333",
          "label": "21:9"
        },
        {
          "value": "1.778",
          "label": "16:9"
        },
        {
          "value": "1.5",
          "label": "3:2"
        },
        {
          "value": "1.333",
          "label": "4:3"
        }
      ],
      "default": "1.778"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "label": "Ratio on phones",
      "options": [
        {
          "value": "same",
          "label": "Same as computers"
        },
        {
          "value": "adapt",
          "label": "Follow the phone image"
        },
        {
          "value": "0.8",
          "label": "4:5"
        },
        {
          "value": "0.667",
          "label": "2:3"
        }
      ],
      "default": "0.8"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap words in *asterisks* to set them in italics on their own line",
      "default": "The great paintings, *framed for your walls.*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop all paintings"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 50,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Link, credit and label size",
      "min": 70,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Art strip"
    },
    {
      "type": "checkbox",
      "id": "show_strip",
      "label": "Show the strip of paintings",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Paintings from"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Paintings",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "strip_size",
      "label": "Strip height",
      "options": [
        {
