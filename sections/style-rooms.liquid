{%- comment -%}
  Shop by style: your style collections as rooms. Each room is a softly lit wall with one painting from the
  collection hung in its frame, the collection's name under it and a small link. Pick the collections in one
  Collections setting.
{%- endcomment -%}

{%- liquid
  assign heading_id = 'StyleRoomsHeading-' | append: section.id
  assign sr_collections = section.settings.collections
  assign woods = 'oak,black,umber,oak,espresso,umber,black,oak' | split: ','
  if section.settings.frame != 'mixed'
    assign woods = section.settings.frame | append: ',' | append: section.settings.frame | split: ','
  endif
-%}

<section data-align="{{ section.settings.sec_text_align }}"
  class="section srooms color-{{ section.settings.color_scheme }}"
  data-pad
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.pad_top }}px; --pb: {{ section.settings.pad_bottom }}px; --head-scale: {{ section.settings.heading_size | divided_by: 100.0 }}; --frame-scale: {{ section.settings.painting_size | divided_by: 100.0 }}; --cols: {{ section.settings.columns }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.side_label != blank -%}
      <div class="sec-head">
        {%- if section.settings.heading != blank -%}
          <h2 id="{{ heading_id }}" class="sec-head__title">{% render 'accent-text', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.side_label != blank -%}
          <a class="sec-head__side sec-head__side--quiet" href="{{ section.settings.side_link | default: routes.collections_url }}">{{ section.settings.side_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <ul class="srooms__grid" role="list">
      {%- if sr_collections != blank -%}
        {%- for room in sr_collections -%}
          {%- liquid
            assign wood_index = forloop.index0 | modulo: woods.size
            assign room_image = room.featured_image | default: room.products.first.featured_media
          -%}
          <li>
            <a class="sroom" href="{{ room.url }}">
              <span class="sroom__wall wall">
                {% render 'folio-frame', image: room_image, wood: woods[wood_index], box_hw: 1.333, max_w: 70, max_h: 50, sizes: '(min-width: 990px) 20vw, 45vw', index: forloop.index %}
              </span>
              <b class="sroom__name">{{ room.title | escape }}</b>
              {%- if section.settings.link_label != blank -%}<span class="sroom__link caps">{{ section.settings.link_label | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign samples = 'sections.style_rooms.samples' | t | split: ',' -%}
        {%- for sample in samples -%}
          {%- assign wood_index = forloop.index0 | modulo: woods.size -%}
          <li>
            <a class="sroom" href="{{ routes.collections_url }}">
              <span class="sroom__wall wall">
                {% render 'folio-frame', wood: woods[wood_index], box_hw: 1.333, max_w: 70, max_h: 50, index: forloop.index %}
              </span>
              <b class="sroom__name">{{ sample | strip | escape }}</b>
              {%- if section.settings.link_label != blank -%}<span class="sroom__link caps">{{ section.settings.link_label | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .srooms__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: calc(var(--d) * 1.2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sroom {
    display: grid;
    gap: calc(var(--d) * 0.9);
    color: inherit;
    text-decoration: none;
  }
  .sroom__wall {
    aspect-ratio: 3 / 4;
  }
  .sroom .frame {
    transition: translate 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sroom:hover .frame {
    translate: 0 calc(var(--d) * -0.45);
  }
  .sroom__name {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--d) * 1.9);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .sroom__link {
    color: var(--color-muted);
  }
  @media (max-width: 749px) {
    .srooms__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: calc(var(--d) * 2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by style",
  "tag": "div",
  "class": "style-rooms-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection_list", "id": "collections", "label": "Collections", "info": "Each collection shows as a room with its image (or first painting) on the wall", "limit": 8 },
    {
      "type": "select",
      "id": "frame",
      "label": "Frames",
      "options": [
        { "value": "mixed", "label": "A different wood for each" },
        { "value": "oak", "label": "Oak" },
        { "value": "umber", "label": "Umber" },
        { "value": "espresso", "label": "Espresso" },
        { "value": "black", "label": "Black" },
        { "value": "none", "label": "No frame" }
      ],
      "default": "mixed"
    },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in *asterisks* to set them in italics", "default": "Shop by *style*" },
    { "type": "text", "id": "side_label", "label": "Small link beside the heading", "default": "Collections" },
    { "type": "url", "id": "side_link", "label": "Small link" },
    { "type": "text", "id": "link_label", "label": "Link under each room", "default": "Shop the room" },
    { "type": "range", "id": "columns", "label": "Columns on computers", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "painting_size", "label": "Painting size", "min": 60, "max": 125, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "pad_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [{ "name": "Shop by style" }]
}
{% endschema %}
