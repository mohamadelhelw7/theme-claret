{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign limit = section.settings.limit
-%}

<section data-align="{{ section.settings.sec_text_align }}" data-pad
  class="section color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <div class="page-width showcase showcase--images-{{ section.settings.image_position }}">
    <div class="showcase__images">
      {% content_for 'blocks' %}
    </div>

    <card-slider class="showcase__products">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        description: section.settings.description,
        alignment: section.settings.header_alignment,
        slider: true
      %}
      <ul
        class="slider-track slider-track--products"
        role="list"
        data-slider-track
        style="--slider-cols: {{ section.settings.columns }};"
      >
        {%- for product in source.products limit: limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index %}</li>
        {%- else -%}
          {%- for i in (1..3) -%}
            <li>{% render 'product-card', product: blank, index: i %}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}
        <div class="showcase__button">
          <a class="button button--primary" href="{{ source.url }}">
            {{- section.settings.button_label | escape }}
            {% render 'icon', icon: 'arrow-up-right' %}
          </a>
        </div>
      {%- endif -%}
    </card-slider>
  </div>
</section>

{% stylesheet %}
  .showcase {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
  }
  .showcase--images-end .showcase__images {
    order: 2;
  }
  .showcase__images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .showcase__images:has(> :only-child) {
    grid-template-columns: 1fr;
  }
  .showcase-tile {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-surface);
  }
  .showcase-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.7s ease;
  }
  .showcase-tile:hover img {
    scale: 1.05;
  }
  .showcase-tile__link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .showcase-tile__label {
    position: absolute;
    inset-inline-start: 12px;
    bottom: 12px;
    padding: 6px 10px;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: calc(0.6875rem * var(--sec-t, 1));
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
  }
  .showcase__products {
    min-width: 0;
  }
  .showcase__button {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }
  @media (max-width: 989px) {
    .showcase {
      grid-template-columns: 1fr;
    }
    .showcase--images-end .showcase__images {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection showcase",
  "tag": "div",
  "class": "collection-showcase-section",
  "max_blocks": 4,
  "blocks": [{ "type": "_showcase-image" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Pieces picked for every day of the week." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "split"
    },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use all products" },
    { "type": "range", "id": "limit", "label": "Products", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Products in view", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "image_position",
      "label": "Photos position",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [
    {
      "name": "Collection showcase",
      "blocks": [
        { "type": "_showcase-image" },
        { "type": "_showcase-image" },
        { "type": "_showcase-image" },
        { "type": "_showcase-image" }
      ]
    }
  ]
}
{% endschema %}
