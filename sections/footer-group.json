{
  "type": "footer",
  "name": "Footer",
  "sections": {
    "footer": {
      "type": "claret-footer",
      "blocks": {
        "menu_shop": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Shop",
            "menu": "main-menu"
          }
        },
        "menu_help": {
          "type": "_footer-menu",
          "settings": {
            "heading": "Help",
            "menu": "footer"
          }
        },
        "follow": {
          "type": "_footer-text",
          "settings": {
            "heading": "Follow",
            "text": "<p><a href=\"https://www.instagram.com/artcellareg\">Instagram</a></p>"
          }
        },
        "language": {
          "type": "_footer-text",
          "settings": {
            "heading": "Language",
            "text": "<p>English · العربية</p>"
          }
        }
      },
      "block_order": [
        "menu_shop",
        "menu_help",
        "follow",
        "language"
      ],
      "settings": {
        "color_scheme": "scheme-2",
        "margin_top": "none",
        "wordmark": "Art *Cellar*",
        "show_signup": true,
        "signup_heading": "Join the list",
        "signup_text": "<p>New paintings and offers, by email.</p>",
