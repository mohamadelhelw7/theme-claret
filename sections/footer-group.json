        "show_powered_by": false
      }
    },
    "popup": {
      "type": "popup",
      "settings": {
        "enable": false,
        "color_scheme": "scheme-2",
        "content": "newsletter",
        "trigger": "scroll",
        "delay": 8,
        "scroll_percent": 40,
        "frequency": 7,
        "pages": "all",
        "show_mobile": true,
        "position": "corner",
        "layout": "stacked",
        "image_position": "start",
        "image_shape": "square",
        "eyebrow": "The club",
        "heading": "New pieces,\n*first*",
        "text": "<p>New arrivals, restocks and the journal, by email.</p>",
        "button_label": "Shop now",
        "dismiss_label": "Not now"
