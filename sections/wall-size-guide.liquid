  .tsg__thumb { position: relative; width: 44px; height: 56px; box-shadow: 0 2px 6px rgba(0,0,0,.12); }
  .tsg__thumb .tsg__art { inset: 3px; }
  .tsg__thumb.tsg__frame--none .tsg__art, .tsg__thumb.tsg__frame--photo .tsg__art { inset: 0; }
  .tsg__arttone { font: 500 calc(var(--d) * 0.54) / 1.3 var(--font-body); letter-spacing: 0.1em; color: var(--tsg-muted); text-transform: uppercase; }
