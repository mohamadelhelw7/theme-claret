    { "type": "textarea", "id": "custom_text", "label": "Custom size text", "default": "Don't see your size? Enter any width and height from 20 to 200 cm. We print and frame it to order." },
    { "type": "url", "id": "custom_link", "label": "Custom order link", "info": "Optional. For example your WhatsApp link." },
