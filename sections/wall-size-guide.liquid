{%- comment -%}
  Size guide (page section), the same tool as Art Cellar's Atelier guide, in Claret's look.
  Add it to a page template (page.size-guide). Open it from a product with /pages/size-guide?product=<handle>:
  with a product handle, the guide reads that product's own sizes from its Size option and offers its photo
  as the artwork; without one it uses the size sets below. The wall, furniture and art are drawn to scale.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
-%}

<tac-size-guide
  id="tsg-{{ sid }}"
  class="tsg color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --tsg-max: {{ section.settings.max_width }}px; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --tsg-wall-color: {{ section.settings.wall_color }}; --head-scale: {{ section.settings.heading_size | divided_by: 100.0 }}; --text-scale: {{ section.settings.text_size | divided_by: 100.0 }};"
>
  <script type="application/json" data-tsg-config>
    {
      "sizeOption": {{ section.settings.size_option_name | json }},
      "sizeOrder": {{ section.settings.size_order | json }},
      "square": {{ section.settings.sizes_square | json }},
      "vertical": {{ section.settings.sizes_vertical | json }},
      "horizontal": {{ section.settings.sizes_horizontal | json }},
      "gap": {{ section.settings.gap_cm | json }},
      "above": {{ section.settings.above_furniture | json }},
      "lift": {{ section.settings.wall_lift | json }},
      "pieces": {{ section.settings.default_pieces | plus: 0 | json }},
      "customMin": {{ section.settings.custom_min | json }},
      "customMax": {{ section.settings.custom_max | json }},
      "wallH": {{ section.settings.default_wall_height | json }},
      "root": {{ routes.root_url | json }},
      "t": {
        "furn": {
          "sofa": {{ 'sections.wall_size_guide.sofa' | t | json }},
          "bed": {{ 'sections.wall_size_guide.bed' | t | json }},
          "console": {{ 'sections.wall_size_guide.console' | t | json }},
          "dining": {{ 'sections.wall_size_guide.dining' | t | json }},
          "desk": {{ 'sections.wall_size_guide.desk' | t | json }},
          "bench": {{ 'sections.wall_size_guide.bench' | t | json }},
          "fireplace": {{ 'sections.wall_size_guide.fireplace' | t | json }},
          "wall": {{ 'sections.wall_size_guide.wall_only' | t | json }}
        },
        "tones": {
          "soft": {{ 'sections.wall_size_guide.tone_soft' | t | json }},
          "gold": {{ 'sections.wall_size_guide.tone_gold' | t | json }},
          "bright": {{ 'sections.wall_size_guide.tone_bright' | t | json }},
          "dark": {{ 'sections.wall_size_guide.tone_dark' | t | json }},
          "light": {{ 'sections.wall_size_guide.tone_light' | t | json }},
          "vivid": {{ 'sections.wall_size_guide.tone_vivid' | t | json }},
          "muted": {{ 'sections.wall_size_guide.tone_muted' | t | json }},
          "bold": {{ 'sections.wall_size_guide.tone_bold' | t | json }}
        },
        "itemWidth": {{ 'sections.wall_size_guide.item_width' | t | json }},
        "cm": {{ 'sections.wall_size_guide.cm' | t | json }},
        "thisArtwork": {{ 'sections.wall_size_guide.this_artwork' | t | json }},
        "photo": {{ 'sections.wall_size_guide.photo' | t | json }}
      }
    }
  </script>

  <div class="tsg__inner">
    <div class="tsg__head" data-align="{{ section.settings.sec_text_align }}">
      {%- if section.settings.eyebrow != blank -%}
        <div class="tsg__label tsg__label--muted">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      <h1 class="tsg__title">{% render 'accent-text', text: section.settings.heading %}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="tsg__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <p class="tsg__product" data-tsg-product hidden>{{ 'sections.wall_size_guide.showing_for' | t }} <strong data-tsg-product-name></strong></p>
      {%- if section.settings.show_custom and section.settings.custom_badge != blank -%}
        <div class="tsg__badge">{{ section.settings.custom_badge | escape }}</div>
      {%- endif -%}
    </div>

    <div class="tsg__layout">
      <section class="tsg__scene-col" aria-label="{{ 'sections.wall_size_guide.scale_preview' | t }}">
        <div class="tsg__card">
          <div class="tsg__scene-meta">
            <div>{{ 'sections.wall_size_guide.wall' | t }} · <strong data-tsg-wall-label></strong></div>
            <div>{{ 'sections.wall_size_guide.drawn_to_scale' | t }}</div>
          </div>
          <div class="tsg__scene" data-tsg-scene></div>
          <div class="tsg__floor-dims" data-tsg-floor></div>
        </div>
        <div class="tsg__warn" role="status" data-tsg-warn-wide hidden>{{ 'sections.wall_size_guide.warn_wide' | t }}</div>
        <div class="tsg__warn" role="status" data-tsg-warn-tall hidden>{{ 'sections.wall_size_guide.warn_tall' | t }}</div>
      </section>

      <section class="tsg__controls" aria-label="{{ 'sections.wall_size_guide.your_space' | t }}">
        <div class="tsg__group">
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.your_wall' | t }}</h2>
          <div class="tsg__fields">
            {%- assign l_width = 'sections.wall_size_guide.width' | t -%}
            {%- assign l_height = 'sections.wall_size_guide.height' | t -%}
            {%- render 'tsg-number-field', field: 'wallW', label: l_width, min: 100, max: 800, step: 10, sid: sid -%}
            {%- render 'tsg-number-field', field: 'wallH', label: l_height, min: 200, max: 400, step: 10, sid: sid -%}
          </div>
        </div>

        <div class="tsg__group">
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.furniture' | t }}</h2>
          <div class="tsg__grid2">
            <button type="button" class="tsg__opt" data-tsg-furniture="sofa">{{ 'sections.wall_size_guide.sofa' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="bed">{{ 'sections.wall_size_guide.bed' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="wall">{{ 'sections.wall_size_guide.wall_only' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="console">{{ 'sections.wall_size_guide.console' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="dining">{{ 'sections.wall_size_guide.dining' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="fireplace">{{ 'sections.wall_size_guide.fireplace' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="desk">{{ 'sections.wall_size_guide.desk' | t }}</button>
            <button type="button" class="tsg__opt" data-tsg-furniture="bench">{{ 'sections.wall_size_guide.bench' | t }}</button>
          </div>
          <div class="tsg__fields tsg__fields--top" data-tsg-furn-field>
            {%- assign l_sofa = 'sections.wall_size_guide.sofa' | t -%}
            {%- assign l_furn = 'sections.wall_size_guide.item_width' | t | replace: '[item]', l_sofa -%}
            {%- render 'tsg-number-field', field: 'furnW', label: l_furn, min: 60, max: 400, step: 10, sid: sid -%}
          </div>
        </div>

        <div class="tsg__group" data-tsg-shape-group>
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.shape' | t }}</h2>
          <div class="tsg__pills">
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-shape="square"><span class="tsg__shape-icon" style="width:11px;height:11px" aria-hidden="true"></span>{{ 'sections.wall_size_guide.square' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-shape="vertical"><span class="tsg__shape-icon" style="width:9px;height:13px" aria-hidden="true"></span>{{ 'sections.wall_size_guide.vertical' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-shape="horizontal"><span class="tsg__shape-icon" style="width:13px;height:9px" aria-hidden="true"></span>{{ 'sections.wall_size_guide.horizontal' | t }}</button>
          </div>
        </div>

        <div class="tsg__group">
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.pieces' | t }}</h2>
          <div class="tsg__pills">
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-pieces="1">{{ 'sections.wall_size_guide.single' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-pieces="2">{{ 'sections.wall_size_guide.set_2' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-pieces="3">{{ 'sections.wall_size_guide.set_3' | t }}</button>
          </div>
        </div>

        <div class="tsg__group">
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.size' | t }}</h2>
          <div class="tsg__sizes" data-tsg-sizes></div>
        </div>

        {%- if section.settings.show_custom -%}
          <div class="tsg__custom" data-tsg-custom-panel>
            <div class="tsg__custom-head">
              <div>
                <h2 class="tsg__label">{{ section.settings.custom_title | escape }}</h2>
                <p class="tsg__custom-text">{{ section.settings.custom_text | escape }}</p>
              </div>
              <span class="tsg__selected" data-tsg-custom-tag hidden>{{ 'sections.wall_size_guide.selected' | t }}</span>
            </div>
            <div class="tsg__fields">
              {%- assign l_aw = 'sections.wall_size_guide.art_width' | t -%}
              {%- assign l_ah = 'sections.wall_size_guide.art_height' | t -%}
              {%- render 'tsg-number-field', field: 'customW', label: l_aw, min: section.settings.custom_min, max: section.settings.custom_max, step: 5, sid: sid -%}
              {%- render 'tsg-number-field', field: 'customH', label: l_ah, min: section.settings.custom_min, max: section.settings.custom_max, step: 5, sid: sid -%}
            </div>
            <button type="button" class="tsg__btn tsg__btn--solid" data-tsg-custom>{{ 'sections.wall_size_guide.preview_size' | t }}</button>
            {%- if section.settings.custom_link != blank -%}
              <a class="tsg__custom-link" href="{{ section.settings.custom_link }}">{{ section.settings.custom_link_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="tsg__group">
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.preview_art' | t }}</h2>
          <p class="tsg__group-hint">{{ 'sections.wall_size_guide.preview_art_hint' | t }}</p>
          <div class="tsg__arts" data-tsg-arts></div>
        </div>

        <div class="tsg__group" data-tsg-frame-group>
          <h2 class="tsg__label">{{ 'sections.wall_size_guide.frame' | t }}</h2>
          <div class="tsg__pills">
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-frame="oak"><span class="tsg__swatch tsg__frame--oak" aria-hidden="true"></span>{{ 'sections.wall_size_guide.oak' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-frame="umber"><span class="tsg__swatch tsg__frame--umber" aria-hidden="true"></span>{{ 'sections.wall_size_guide.umber' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-frame="espresso"><span class="tsg__swatch tsg__frame--espresso" aria-hidden="true"></span>{{ 'sections.wall_size_guide.espresso' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-frame="black"><span class="tsg__swatch tsg__frame--black" aria-hidden="true"></span>{{ 'sections.wall_size_guide.black' | t }}</button>
            <button type="button" class="tsg__opt tsg__opt--pill" data-tsg-frame="none"><span class="tsg__swatch tsg__swatch--none" aria-hidden="true"></span>{{ 'sections.wall_size_guide.no_frame' | t }}</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</tac-size-guide>

{% stylesheet %}
  /* Claret's look: the light serif title, small spaced capitals, square corners, ink selections and the wall colour */
  .tsg {
    --tsg-ink: var(--color-text, #121212);
    --tsg-bg: var(--color-bg, #ffffff);
    --tsg-muted: var(--color-muted, #6d6d6d);
    --tsg-line: var(--color-border, #e4e4e4);
    --tsg-hover: color-mix(in srgb, var(--tsg-ink) 5%, var(--tsg-bg));
    --tsg-hover-line: color-mix(in srgb, var(--tsg-ink) 35%, var(--tsg-bg));
    --tsg-on-bg: var(--tsg-ink);
    --tsg-on-text: var(--tsg-bg);
    --tsg-input-line: color-mix(in srgb, var(--tsg-ink) 18%, var(--tsg-bg));
    --tsg-wall: var(--tsg-wall-color, var(--wall, #f1f1f0));
    --tsg-radius: var(--input-radius, 0px);
    --tsg-btn-radius: var(--button-radius, 0px);

    display: block;
    background: var(--tsg-bg);
    color: var(--tsg-ink);
    padding: var(--pt, 24px) 0 var(--pb, 64px);
    font-family: var(--font-body);
    font-size: calc(var(--d) * 0.82 * var(--text-scale, 1));
    line-height: 1.6;
  }
  .tsg *, .tsg *::before, .tsg *::after { box-sizing: border-box; }
  .tsg [hidden] { display: none !important; }
  .tsg button, .tsg input { font-family: inherit; font-size: inherit; letter-spacing: normal; }
  .tsg__inner { max-width: calc(var(--tsg-max) + var(--gutter) * 2); margin: 0 auto; padding: 0 var(--gutter); }

  /* small headings: Claret's spaced capitals */
  .tsg__label {
    margin: 0;
    font: 500 calc(var(--d) * 0.64) / 1.4 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tsg__label--muted { color: var(--tsg-muted); }

  .tsg__head { margin: 0 0 calc(var(--d) * 2.2); display: flex; flex-direction: column; gap: calc(var(--d) * 0.8); align-items: flex-start; }
  .tsg__head[data-align='center'] { align-items: center; }
  .tsg__head[data-align='end'] { align-items: flex-end; }
  .tsg__title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-style: normal;
    font-size: calc(var(--d) * 3.9 * var(--heading-scale, 1) * var(--head-scale, 1));
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .tsg__title em { font-style: italic; }
  .tsg__intro { margin: 0; max-width: 34em; color: var(--tsg-muted); }
  .tsg__product { margin: 0; }
  .tsg__product strong { font-weight: 500; }
  .tsg__badge {
    padding: 0.55em 0.9em;
    border: 1px solid var(--tsg-ink);
    border-radius: var(--tsg-btn-radius);
    font: 500 calc(var(--d) * 0.6) / 1.3 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tsg__layout { display: flex; flex-wrap: wrap; gap: calc(var(--d) * 3); align-items: flex-start; }
  .tsg__scene-col { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .tsg__controls { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: calc(var(--d) * 1.9); }
  .tsg__group > .tsg__label { margin-bottom: 12px; }

  .tsg__card { padding: 0; }
  .tsg__scene-meta {
    display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;
    font: 500 calc(var(--d) * 0.6) / 1.4 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--tsg-muted);
  }
  .tsg__scene-meta strong { color: var(--tsg-ink); font-weight: 500; }
  .tsg__scene { position: relative; width: 100%; background: radial-gradient(70% 60% at 50% 42%, color-mix(in srgb, #ffffff 45%, var(--tsg-wall)), var(--tsg-wall)); overflow: hidden; border-bottom: 1px solid var(--tsg-ink); }
  .tsg__floor-dims { position: relative; height: 34px; }

  /* frames in Claret's woods */
  .tsg__frame {
    position: absolute; overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14), 4px 9px 16px -6px rgba(0, 0, 0, 0.2);
    transition: left .22s ease, bottom .22s ease, width .22s ease, height .22s ease;
  }
  .tsg__frame--oak { background: #d9c09a; }
  .tsg__frame--umber { background: #ad744a; }
  .tsg__frame--espresso { background: #5a3e2b; }
  .tsg__frame--black { background: #2c2c2c; }
  .tsg__frame--photo { background: var(--tsg-bg); }
  .tsg__frame--none { background: transparent; box-shadow: 0 3px 8px rgba(0, 0, 0, 0.22); }
  .tsg__swatch { display: inline-block; width: 14px; height: 14px; box-sizing: border-box; }
  .tsg__swatch--none { border: 1px dashed currentColor; }
  .tsg__group-hint { margin: -6px 0 12px; color: var(--tsg-muted); }

  /* Starry Night */
  .tsg__ai--starry {
    background:
      radial-gradient(circle at 22% 20%, #F4E27A 0 2.5%, rgba(244,226,122,.35) 3% 6%, transparent 7%),
      radial-gradient(circle at 46% 13%, #F4E27A 0 2%, rgba(244,226,122,.35) 2.5% 5%, transparent 6%),
      radial-gradient(circle at 60% 36%, #F4E27A 0 2.5%, rgba(244,226,122,.35) 3% 6%, transparent 7%),
      radial-gradient(circle at 34% 42%, #F4E27A 0 2%, rgba(244,226,122,.3) 2.5% 5%, transparent 6%),
      repeating-radial-gradient(circle at 48% 30%, rgba(130,170,230,.28) 0 2px, transparent 2px 8px),
      linear-gradient(180deg, #172552 0%, #2A4789 60%, #1E3166 100%);
  }
  .tsg__s1 { right: 9%; top: 7%; width: 18%; height: 18%; border-radius: 50%; background: radial-gradient(circle, #F6D14B 0 36%, #F2C230 37% 50%, rgba(242,194,48,.3) 52% 70%, transparent 72%); }
  .tsg__s2 { left: 8%; bottom: 0; width: 15%; height: 76%; border-radius: 50% 50% 12% 12% / 85% 85% 10% 10%; background: #1C2A19; }
  .tsg__s3 { left: 0; right: 0; bottom: 0; height: 17%; background: radial-gradient(circle at 40% 50%, #E9C95A 0 2%, transparent 3%), radial-gradient(circle at 62% 40%, #E9C95A 0 2%, transparent 3%), radial-gradient(circle at 80% 55%, #E9C95A 0 2%, transparent 3%), linear-gradient(#22305A, #151E3C); }
  /* The Great Wave */
  .tsg__ai--wave { background: #EFE6D2; }
  .tsg__g1 { left: -12%; top: 26%; width: 78%; height: 74%; border-radius: 50% 50% 0 0; background: #24426F; }
  .tsg__g2 { left: 2%; top: 22%; width: 50%; height: 22%; border-radius: 50%; background: radial-gradient(circle at 30% 70%, #EFE6D2 0 12%, transparent 13%), radial-gradient(circle at 60% 60%, #EFE6D2 0 10%, transparent 11%), #F7F2E6; }
  .tsg__g3 { left: 58%; top: 58%; width: 26%; height: 18%; clip-path: polygon(50% 0, 100% 100%, 0 100%); background: linear-gradient(180deg, #F7F2E6 0 30%, #4E6E98 31%); }
  .tsg__g4 { left: 0; right: 0; bottom: 0; height: 22%; background: repeating-radial-gradient(ellipse at 50% 0, #4F73A4 0 4px, #6B8DBA 4px 8px); }
  /* Sunflowers */
  .tsg__ai--sun {
    background:
      radial-gradient(circle at 34% 30%, #6B3E12 0 5%, #F2B705 5.5% 12%, transparent 12.5%),
      radial-gradient(circle at 62% 24%, #6B3E12 0 4.5%, #F5C211 5% 11%, transparent 11.5%),
      radial-gradient(circle at 50% 44%, #6B3E12 0 5%, #EFA800 5.5% 12%, transparent 12.5%),
      radial-gradient(circle at 24% 50%, #6B3E12 0 4%, #F2B705 4.5% 10%, transparent 10.5%),
      radial-gradient(circle at 74% 46%, #6B3E12 0 4%, #F7C824 4.5% 10%, transparent 10.5%),
      linear-gradient(180deg, #F0D35A 0 72%, #D4952A 72%);
  }
  .tsg__u1 { left: 36%; bottom: 20%; width: 28%; height: 26%; border-radius: 20% 20% 30% 30%; background: linear-gradient(180deg, #E8B23A 0 50%, #2F6DB5 50% 56%, #E8B23A 56%); }
  /* Impression, Sunrise */
  .tsg__ai--sunrise { background: linear-gradient(180deg, #A2ADB3 0%, #C3B7A6 38%, #98A3A6 52%, #7F8C92 100%); }
  .tsg__r1 { left: 52%; top: 30%; width: 9%; height: 9%; border-radius: 50%; background: #E8692E; }
  .tsg__r2 { left: 53%; top: 50%; width: 7%; height: 34%; background: repeating-linear-gradient(0deg, #E8692E 0 2px, transparent 2px 7px); opacity: .85; }
  .tsg__r3 { left: 26%; top: 60%; width: 14%; height: 5%; border-radius: 0 0 50% 50%; background: #3E4A52; }
  .tsg__r4 { left: 70%; top: 66%; width: 10%; height: 4%; border-radius: 0 0 50% 50%; background: #4A5660; }
  .tsg__r5 { left: 10%; top: 32%; width: 22%; height: 12%; background: linear-gradient(90deg, transparent, rgba(80,90,100,.45), transparent); }
  /* Pearl Earring */
  .tsg__ai--pearl { background: radial-gradient(ellipse at 45% 45%, #1E1E1C 0 40%, #0E0E0D 80%); }
  .tsg__p1 { left: 31%; top: 30%; width: 34%; height: 44%; border-radius: 48% 48% 46% 46%; background: linear-gradient(100deg, #EBCDAA, #C9A27E); }
  .tsg__p2 { left: 27%; top: 17%; width: 44%; height: 24%; border-radius: 50% 50% 30% 30%; background: linear-gradient(180deg, #3A6CB4, #22457E); }
  .tsg__p3 { left: 60%; top: 14%; width: 14%; height: 44%; border-radius: 30% 30% 50% 50%; background: linear-gradient(180deg, #E2BE5A, #B88F33); }
  .tsg__p4 { left: 37%; top: 63%; width: 5%; height: 5%; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #FFFFFF 0 25%, #B9BEC4 60%); }
  .tsg__p5 { left: 18%; bottom: 0; width: 64%; height: 24%; border-radius: 50% 50% 0 0; background: #6B4E2C; }
  /* Composition (Mondrian) */
  .tsg__ai--grid { background: #F4F1E8; }
  .tsg__m1 { left: 0; top: 0; width: 32%; height: 38%; background: #D7261E; }
  .tsg__m2 { left: 76%; top: 72%; width: 24%; height: 28%; background: #1E4E9C; }
  .tsg__m3 { left: 0; top: 86%; width: 32%; height: 14%; background: #F2D21B; }
  .tsg__m4 { left: 32%; top: 0; width: 3%; height: 100%; background: #111111; }
  .tsg__m5 { left: 74%; top: 38%; width: 3%; height: 62%; background: #111111; }
