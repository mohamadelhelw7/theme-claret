  .tsg__k5 { left: 0; right: 0; bottom: 0; height: 18%; background: radial-gradient(circle at 15% 50%, #E3A14A 0 8%, transparent 10%), radial-gradient(circle at 45% 40%, #6C9A57 0 8%, transparent 10%), radial-gradient(circle at 80% 55%, #D96A6A 0 8%, transparent 10%), #7F8F45; }
