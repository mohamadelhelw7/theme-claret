        { "value": "3", "label": "Set of 3" }
      ],
      "default": "1"
    },
    { "type": "header", "content": "Hanging rules" },
    { "type": "range", "id": "default_wall_height", "label": "Starting wall height", "min": 200, "max": 400, "step": 5, "unit": "cm", "default": 230 },
    { "type": "range", "id": "gap_cm", "label": "Gap between pieces", "min": 2, "max": 15, "step": 1, "unit": "cm", "default": 5 },
    { "type": "range", "id": "above_furniture", "label": "Height above furniture", "min": 10, "max": 40, "step": 1, "unit": "cm", "default": 20 },
    { "type": "range", "id": "wall_lift", "label": "Wall only: height above center", "info": "On an empty wall, the art is centered on the wall and lifted up by this amount.", "min": 0, "max": 30, "step": 1, "unit": "cm", "default": 8 },
    { "type": "header", "content": "Look" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "wall_color", "label": "Wall color", "default": "#F1F1F0" },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1440 },
    { "type": "header", "content": "Text sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 64 },
    { "type": "header", "content": "Text" },
    {
