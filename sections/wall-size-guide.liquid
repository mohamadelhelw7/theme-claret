  .tsg__artbtn {
    display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 10px 6px;
    border: 1px solid var(--tsg-line); border-radius: var(--tsg-radius);
    background: var(--tsg-bg); color: var(--tsg-ink);
    font-size: calc(var(--d) * 0.66); line-height: 1.3; text-align: center; cursor: pointer;
    transition: border-color .15s;
  }
  .tsg__artbtn:hover { border-color: var(--tsg-hover-line); }
