  .tsg__l3 { left: 22%; top: 70%; width: 5%; height: 5%; border-radius: 50%; background: #1A1A1A; }
  .tsg__art { position: absolute; overflow: hidden; container-type: size; }
  .tsg__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

