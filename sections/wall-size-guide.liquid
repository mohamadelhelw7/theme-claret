  .tsg__fields { display: flex; flex-wrap: wrap; gap: 12px; }
  .tsg__fields--top { margin-top: 12px; }
  .tsg__field { flex: 1 1 180px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
