    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Enter your wall and furniture sizes, then try different frame sizes. The drawing is to scale, so you can see exactly how the art will look in your room." },
    { "type": "header", "content": "Custom sizes" },
    { "type": "checkbox", "id": "show_custom", "label": "Show custom size", "default": true },
