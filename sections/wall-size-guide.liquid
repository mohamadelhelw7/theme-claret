  .tsg__stepper button {
    width: 46px; height: 46px; flex: none; border: 0; background: transparent; color: var(--tsg-ink);
    font-size: 16px; cursor: pointer; padding: 0;
  }
  .tsg__stepper button:hover { background: var(--tsg-hover); }
  .tsg__stepper input {
    flex: 1; width: 0; min-width: 0; height: 46px; border: 0; background: transparent; text-align: center; padding: 0;
    font-size: 16px; color: var(--tsg-ink); -moz-appearance: textfield; border-radius: 0; font-variant-numeric: tabular-nums;
  }
  .tsg__stepper input:focus { outline: none; }
  .tsg__stepper:focus-within { border-color: var(--tsg-ink); }
  .tsg__stepper input::-webkit-inner-spin-button, .tsg__stepper input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .tsg__unit { font-size: calc(var(--d) * 0.7); color: var(--tsg-muted); padding-inline-end: 8px; }

  /* choice buttons */
  .tsg__grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tsg__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .tsg__opt, .tsg__size {
    min-height: 44px; border: 1px solid var(--tsg-line); border-radius: var(--tsg-radius);
    background: var(--tsg-bg); color: var(--tsg-ink);
    font-size: calc(var(--d) * 0.76); font-weight: 400; cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
  }
  .tsg__opt:hover, .tsg__size:hover { border-color: var(--tsg-hover-line); }
  .tsg__opt--pill { padding: 0 16px; display: inline-flex; align-items: center; gap: 8px; }
  .tsg__shape-icon { display: inline-block; border: 1px solid currentColor; }
  .tsg__opt[aria-pressed="true"], .tsg__size[aria-pressed="true"] { background: var(--tsg-on-bg); color: var(--tsg-on-text); border-color: var(--tsg-on-bg); }

  .tsg__sizes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .tsg__size { width: 100%; padding: 0 12px; font-variant-numeric: tabular-nums; }

  .tsg__custom {
    border: 1px solid var(--tsg-line); border-radius: var(--tsg-radius); padding: 16px;
    display: flex; flex-direction: column; gap: 12px; transition: border-color .15s;
  }
  .tsg__custom.is-active { border-color: var(--tsg-ink); }
  .tsg__custom-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .tsg__custom-text { margin: 6px 0 0; color: var(--tsg-muted); line-height: 1.6; }
  .tsg__selected {
    flex: none; padding: 3px 8px; background: var(--tsg-on-bg); color: var(--tsg-on-text);
    font: 500 calc(var(--d) * 0.56) / 1.4 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase;
  }
  .tsg__custom-link { color: var(--tsg-ink); text-decoration: underline; text-underline-offset: 3px; align-self: flex-start; }

  @media (max-width: 749px) {
    .tsg { padding: calc(var(--pt, 24px) * 0.6) 0 calc(var(--pb, 64px) * 0.6); }
    .tsg__layout { gap: 32px; }
    .tsg__title { font-size: calc(var(--d) * 2.6 * var(--heading-scale, 1) * var(--head-scale, 1)); }
  }
{% endstylesheet %}

