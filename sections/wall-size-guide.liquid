  .tsg__hdim--below span { bottom: auto; top: 4px; }
  .tsg__vdim { position: absolute; width: 0; border-left: 1px solid var(--tsg-ink); }
  .tsg__vdim::before, .tsg__vdim::after { content: ""; position: absolute; left: -4px; width: 7px; border-top: 1px solid var(--tsg-ink); }
  .tsg__vdim::before { top: 0; } .tsg__vdim::after { bottom: 0; }
  .tsg__vdim span {
    position: absolute; right: 4px; top: 50%; transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl; font-size: 11px; white-space: nowrap; line-height: 1.4; font-variant-numeric: tabular-nums;
  }
