<div data-align="{{ section.settings.sec_text_align }}" data-pad class="section color-{{ section.settings.color_scheme }}" style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};">
  <div class="page-width">
    <div class="page-title-block">
      <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    </div>
    {%- paginate collections by 24 -%}
      <ul class="list-collections" role="list">
        {%- for item in collections -%}
          <li>
            <a href="{{ item.url }}" class="collection-card">
              <div class="collection-card__media media-tile" style="--tile-bg: var(--tint-{{ forloop.index | modulo: 4 | plus: 1 }});">
                {%- if item.featured_image -%}
                  {{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
                {%- else -%}
                  {% render 'media-placeholder', kind: 'collection', index: forloop.index, label: item.title %}
                {%- endif -%}
              </div>
              <div class="collection-card__info">
                <div>
                  <h2 class="collection-card__title" style="font: inherit; font-weight: 600; font-size: 1.125rem;">{{ item.title | escape }}</h2>
                  <div class="collection-card__count">{{ 'collections.product_count' | t: count: item.products_count }}</div>
                </div>
                <span class="collection-card__arrow" aria-hidden="true">{% render 'icon', icon: 'arrow-up-right' %}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .list-collections {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 749px) {
    .list-collections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list page",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ]
}
{% endschema %}
