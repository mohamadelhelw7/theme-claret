{%- liquid
  assign source_blog = section.settings.blog | default: blogs.news
  assign limit = section.settings.limit
  assign is_slider = false
  if section.settings.layout == 'slider'
    assign is_slider = true
  endif
-%}

<section data-align="{{ section.settings.sec_text_align }}" data-pad
  class="section color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <card-slider class="page-width">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: section.settings.header_alignment,
      slider: is_slider,
      link_url: source_blog.url,
      link_label: section.settings.link_label
    %}
    <ul
      class="blog-posts blog-posts--{{ section.settings.card_style }}{% if is_slider %} slider-track{% else %} blog-posts--grid{% endif %}"
      role="list"
      style="--slider-cols: {{ section.settings.columns }}; --blog-cols: {{ section.settings.columns }};"
      {% if is_slider %}
        data-slider-track
      {% endif %}
    >
      {%- for article in source_blog.articles limit: limit -%}
        <li>
          <article class="post-card">
            <div class="post-card__media">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 1000
                  | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 85vw', loading: 'lazy', alt: ''
                }}
              {%- else -%}
                {% render 'media-placeholder', kind: 'article', index: forloop.index %}
              {%- endif -%}
            </div>
            <div class="post-card__body">
              <h3 class="post-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {%- if section.settings.show_excerpt -%}
                <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
              <div class="post-card__meta">
                {%- if section.settings.show_author -%}<span>{{ article.author | escape }}</span>{%- endif -%}
                {%- if section.settings.show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
              </div>
            </div>
          </article>
        </li>
      {%- else -%}
        {%- for i in (1..3) -%}
          <li>
            <article class="post-card">
              <div class="post-card__media">{% render 'media-placeholder', kind: 'article', index: i %}</div>
              <div class="post-card__body">
                <h3 class="post-card__title">{{ 'sections.blog_posts.placeholder_title' | t }}</h3>
                {%- if section.settings.show_excerpt -%}
                  <p class="post-card__excerpt">{{ 'sections.blog_posts.placeholder_excerpt' | t }}</p>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </card-slider>
</section>

{% stylesheet %}
  .blog-posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog-posts--grid {
    display: grid;
    grid-template-columns: repeat(var(--blog-cols), minmax(0, 1fr));
    gap: var(--grid-gap);
  }
  .post-card {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .post-card__media {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: var(--tint-1);
  }
  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.7s ease;
  }
  .post-card:hover .post-card__media img {
    scale: 1.05;
  }
  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 18px;
    flex: 1;
  }
  .post-card__title {
    font-family: var(--font-heading);
    font-stretch: var(--heading-stretch, 100%);
    font-weight: var(--font-heading-weight);
    text-transform: var(--heading-case);
    letter-spacing: var(--heading-ls);
    font-size: calc(1rem * var(--sec-t, 1));
    line-height: 1.35;
  }
  .post-card__title a {
    text-decoration: none;
    color: inherit;
  }
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .post-card__excerpt {
    font-size: calc(0.875rem * var(--sec-t, 1));
    color: var(--color-body);
    line-height: 1.6;
  }
  .post-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    font-size: calc(0.75rem * var(--sec-t, 1));
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .blog-posts--overlay .post-card {
    color: var(--color-accent-contrast);
  }
  .blog-posts--overlay .post-card__media {
    aspect-ratio: 4 / 3;
  }
  .blog-posts--overlay .post-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-accent) 94%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 70%, transparent) 42%,
      transparent 75%
    );
  }
  .blog-posts--overlay .post-card__body {
    position: absolute;
    inset: auto 0 0;
    padding: 22px;
  }
  .blog-posts--overlay .post-card__excerpt,
  .blog-posts--overlay .post-card__meta {
    color: inherit;
    opacity: 0.88;
  }
  .blog-posts--overlay .post-card__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 989px) {
    .blog-posts--grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 749px) {
    .blog-posts--grid {
      grid-template-columns: 1fr;
    }
    .blog-posts--overlay .post-card__media {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "div",
  "class": "blog-posts-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "inline_richtext", "id": "description", "label": "Description", "default": "Styling notes, new arrivals and what's coming next." },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "split"
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All posts" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Defaults to your News blog" },
    { "type": "range", "id": "limit", "label": "Posts", "min": 2, "max": 9, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "slider"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "overlay", "label": "Text over photo" },
        { "value": "classic", "label": "Text under photo" }
      ],
      "default": "overlay"
    },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
