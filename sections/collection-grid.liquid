{%- comment -%}
  From the collection: a collection's paintings as wall cards in a grid, under a large light serif heading with a
  View all link beside it.
{%- endcomment -%}

{%- liquid
  assign cg_collection = section.settings.collection
  assign cg_limit = section.settings.products_to_show
  assign heading_id = 'CollectionGridHeading-' | append: section.id
  assign cg_link = section.settings.link | default: cg_collection.url | default: routes.all_products_collection_url
-%}

<section
  class="section cgrid color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }}); --head-scale: {{ section.settings.heading_size | divided_by: 100.0 }}; --sec-art: {{ section.settings.painting_size | divided_by: 100.0 }}; --sec-text: {{ section.settings.text_size | divided_by: 100.0 }};"
  {% if section.settings.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="sec-head">
        {%- if section.settings.heading != blank -%}
          <h2 id="{{ heading_id }}" class="sec-head__title">{% render 'accent-text', text: section.settings.heading %}</h2>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a class="sec-head__side" href="{{ cg_link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <ul class="product-grid cgrid__grid" role="list" style="--cols-desktop: {{ section.settings.columns_desktop }}; --cols-mobile: {{ section.settings.columns_mobile }};">
      {%- if cg_collection != blank and cg_collection.products_count > 0 -%}
        {%- for product in cg_collection.products limit: cg_limit -%}
          <li>{% render 'product-card', product: product, index: forloop.index %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..cg_limit) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .cgrid__grid {
    column-gap: calc(var(--d) * 1.6);
    row-gap: calc(var(--d) * 2.6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection grid",
  "tag": "div",
  "class": "collection-grid-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in *asterisks* to set them in italics", "default": "From *the collection*" },
    { "type": "text", "id": "link_label", "label": "Link beside the heading", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the collection" },
    { "type": "range", "id": "products_to_show", "label": "Paintings to show", "min": 2, "max": 24, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on computers", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 50, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "painting_size", "label": "Painting size", "min": 60, "max": 125, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_size", "label": "Card text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors and spacing" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}
