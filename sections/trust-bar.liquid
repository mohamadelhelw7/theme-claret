<div data-pad class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};">
  <div class="page-width trust-bar trust-bar--{{ section.settings.style }}">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .trust-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--grid-gap);
  }
  @media (max-width: 749px) {
    .trust-bar {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--grid-gap);
    }
    .trust-bar .feature {
      flex-direction: column;
      align-items: flex-start;
      padding: 16px;
      gap: 10px;
    }
  }
  .trust-bar--lines {
    gap: 0;
  }
  .trust-bar--lines > * {
    padding-block: 22px;
    padding-inline: 24px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .trust-bar--lines .feature {
    background: transparent;
    border-radius: 0;
    padding: 0;
  }
  .trust-bar--lines > * + * {
    border-inline-start: 1px solid var(--color-border);
  }
  @media (max-width: 749px) {
    .trust-bar--lines > * {
      padding: 16px 12px;
    }
    .trust-bar--lines > *:nth-child(odd) {
      border-inline-start: none;
    }
    .trust-bar--lines > *:nth-child(n + 3) {
      border-top: none;
    }
  }
  .trust-bar--columns {
    gap: clamp(24px, 4vw, 48px);
  }
  .trust-bar--columns .feature {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    background: transparent;
    padding: 0;
    border-radius: 0;
  }
  .trust-bar--columns .feature__icon {
    color: var(--color-text);
  }
  .trust-bar--columns .feature__icon .icon,
  .trust-bar--columns .feature__img {
    width: 52px;
    height: 52px;
    stroke-width: 1.1;
  }
  .trust-bar--columns .feature__title {
    font-family: var(--font-heading);
    font-stretch: var(--heading-stretch, 100%);
    font-weight: var(--font-heading-weight);
    font-size: calc(1.3125rem * var(--sec-t, 1));
    letter-spacing: var(--heading-ls);
  }
  .trust-bar--columns .feature__text {
    font-size: calc(0.9375rem * var(--sec-t, 1));
    color: var(--color-body);
    max-width: 30ch;
    margin-inline: auto;
    line-height: 1.6;
  }
  @media (max-width: 749px) {
    .trust-bar--columns {
      gap: 32px 16px;
    }
    .trust-bar--columns .feature {
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "trust-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "_feature"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "lines",
          "label": "Thin dividers"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "columns",
          "label": "Large centered icons"
        }
      ],
      "default": "lines"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "_feature",
          "settings": {
            "icon": "drop",
            "title": "Chosen materials",
            "text": "Made to be lived with"
          }
        },
        {
          "type": "_feature",
          "settings": {
            "icon": "truck",
            "title": "Delivery",
            "text": "Add your delivery times"
          }
        },
        {
          "type": "_feature",
          "settings": {
            "icon": "heart",
            "title": "Secure checkout",
            "text": "Pay safely online"
          }
        },
        {
          "type": "_feature",
          "settings": {
            "icon": "return",
            "title": "Returns",
            "text": "See our return policy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
