<div data-align="{{ section.settings.sec_text_align }}" style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};" class="password">
  <div class="password__card">
    <div class="site-header__wordmark">{{ shop.name | escape }}<span class="site-header__dot">.</span></div>
    <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
        <input id="PasswordEmail" class="field__input" type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required>
        <button type="submit" class="button button--primary">{{ 'newsletter.button' | t }}</button>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'templates.password.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="visually-hidden" for="StorePassword">{{ 'templates.password.password' | t }}</label>
        <input id="StorePassword" class="field__input" type="password" name="password" placeholder="{{ 'templates.password.password' | t }}" autocomplete="current-password">
        <button type="submit" class="button button--secondary">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% stylesheet %}
  .password {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--pt, 24px) 16px var(--pb, 24px);
    background: var(--tint-1);
  }
  .password__card {
    width: min(520px, 100%);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
  .password__message {
    color: var(--color-body);
  }
  .password__form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .password__form .field__input {
    flex: 1 1 220px;
  }
  .password__login summary {
    cursor: pointer;
    font-size: calc(0.875rem * var(--sec-t, 1));
    font-weight: 600;
    margin-bottom: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "size_heading",
      "label": "Heading size",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "size_text",
      "label": "Text size",
      "min": 70,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ]
}
{% endschema %}
