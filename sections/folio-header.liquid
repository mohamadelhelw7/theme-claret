    { "type": "range", "id": "pad_block", "label": "Padding above and below", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 20 },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky header",
      "options": [
        { "value": "none", "label": "Off" },
        { "value": "always", "label": "Always visible" },
        { "value": "scroll_up", "label": "Hide on scroll down" }
      ],
      "default": "scroll_up"
    },
    { "type": "checkbox", "id": "show_border", "label": "Line under the header", "default": true },
    { "type": "header", "content": "Over the first section" },
