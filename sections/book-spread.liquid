{%- comment -%}
  Turn of the page: a collection shown as an open art book. The left page holds the painting as a plate,
  the right page its title, artist, price and a link. Clicking the right page (or the arrow) turns it
  over in 3D to the next painting; the left page or the back arrow turns back. Arrow keys work too.
  On phones each painting is one page, swiped sideways.
{%- endcomment -%}

{%- liquid
  assign heading_id = 'BookHeading-' | append: section.id
  assign bk_collection = section.settings.collection
  assign bk_count = section.settings.limit
  if bk_collection != blank and bk_collection.products.size < bk_count
    assign bk_count = bk_collection.products.size
  endif
  assign bk_start = section.settings.plate_start
-%}

<section
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: var(--space-{{ section.settings.padding_top }}); --pb: var(--space-{{ section.settings.padding_bottom }}); --head-scale: {{ section.settings.heading_size | divided_by: 100.0 }}; --book-scale: {{ section.settings.book_height | divided_by: 100.0 }}; --plate-scale: {{ section.settings.painting_size | divided_by: 100.0 }}; --title-scale: {{ section.settings.title_size | divided_by: 100.0 }}; --text-scale: {{ section.settings.text_size | divided_by: 100.0 }};"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    <div class="plate-head">
      <h2 id="{{ heading_id }}" class="plate-head__title">{{ section.settings.heading | escape }}</h2>
      <span class="plate-head__link">{{ 'sections.book.turn' | t }}</span>
    </div>

    {%- if bk_collection != blank and bk_count > 0 -%}
      {%- assign products = bk_collection.products -%}
      <book-spread class="book" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        <div class="book__pages">
          <div class="book__page book__page--left">
            {%- assign first = products.first -%}
            {% render 'book-plate', product: first, number: bk_start %}
          </div>
          <div class="book__page book__page--right book__end">
            <span class="book__end-title">{{ 'sections.book.end' | t }}</span>
            <a class="book__go" href="{{ bk_collection.url }}">{{ 'sections.book.see_all' | t }}</a>
          </div>
          {%- for product in products limit: bk_count -%}
            {%- liquid
              assign number = bk_start | plus: forloop.index0
              assign next_index = forloop.index
              assign next_number = number | plus: 1
            -%}
            <div class="book__leaf" data-leaf>
              <div class="book__face book__face--front book__page--right">
                <div class="book__text">
                  <span class="book__no">{{ 'sections.book.plate' | t: number: number }}</span>
                  <h3 class="book__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                  {%- if product.vendor != blank and product.vendor != shop.name -%}<p class="book__by">{{ product.vendor | escape }}</p>{%- endif -%}
                  <div class="book__row">
                    <span>{%- assign from_price = product.price_min | money -%}{{ 'products.product.price_from' | t: price: from_price }}</span>
                    {% render 'frame-dots' %}
                  </div>
                  <a class="book__go" href="{{ product.url }}">{{ 'sections.spotlight.view' | t }}</a>
                </div>
              </div>
              <div class="book__face book__face--back book__page--left">
                {%- if forloop.last -%}
                  <div class="book__end">
                    <span class="book__end-title">{{ shop.name | escape }}</span>
                    <a class="book__go" href="{{ bk_collection.url }}">{{ 'sections.book.see_all' | t }}</a>
                  </div>
                {%- else -%}
                  {% render 'book-plate', product: products[next_index], number: next_number %}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        <div class="book__nav">
          <button type="button" class="book__arrow" data-turn="-1" aria-label="{{ 'sections.book.previous' | t }}">←</button>
          <span class="book__count" data-book-count aria-live="polite">{{ 'sections.book.plate' | t: number: bk_start }}</span>
          <button type="button" class="book__arrow" data-turn="1" aria-label="{{ 'sections.book.next' | t }}">→</button>
        </div>
        <ul class="book__phone" role="list">
          {%- for product in products limit: bk_count -%}
            {%- assign number = bk_start | plus: forloop.index0 -%}
            <li class="book__phone-page">
              {% render 'book-plate', product: product, number: number %}
              <div class="book__text">
                <h3 class="book__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                {%- if product.vendor != blank and product.vendor != shop.name -%}<p class="book__by">{{ product.vendor | escape }}</p>{%- endif -%}
                <div class="book__row">
                  <span>{%- assign from_price = product.price_min | money -%}{{ 'products.product.price_from' | t: price: from_price }}</span>
                  {% render 'frame-dots' %}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </book-spread>
    {%- else -%}
      <div class="book book--empty">
        <div class="book__pages">
          <div class="book__page book__page--left">{% render 'book-plate', number: bk_start %}</div>
          <div class="book__page book__page--right">
            <div class="book__text">
              <span class="book__no">{{ 'sections.book.plate' | t: number: bk_start }}</span>
              <h3 class="book__title">{{ 'products.product.placeholder_title' | t }}</h3>
              <p class="book__by">{{ 'sections.book.empty' | t }}</p>
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% javascript %}
  if (!customElements.get('book-spread')) {
    class BookSpread extends HTMLElement {
      connectedCallback() {
        this.leaves = Array.from(this.querySelectorAll('[data-leaf]'));
        this.count = this.querySelector('[data-book-count]');
        this.start = Number(this.querySelector('.book__no')?.textContent.replace(/\D/g, '')) || 1;
        this.label = this.count ? this.count.textContent.replace(/\d+/, '{n}') : '{n}';
        this.k = 0;
        this.addEventListener('click', (event) => {
          if (event.target.closest('a')) return;
          const arrow = event.target.closest('[data-turn]');
          if (arrow) return this.turn(Number(arrow.dataset.turn));
          const leaf = event.target.closest('[data-leaf]');
          if (leaf) this.turn(leaf.classList.contains('is-turned') ? -1 : 1);
          else if (event.target.closest('.book__page--left')) this.turn(-1);
        });
        this.addEventListener('keydown', (event) => {
          const rtl = getComputedStyle(this).direction === 'rtl';
          if (event.key === 'ArrowRight') this.turn(rtl ? -1 : 1);
          if (event.key === 'ArrowLeft') this.turn(rtl ? 1 : -1);
        });
        this.order();
      }

      turn(step) {
        if (step > 0 && this.k < this.leaves.length) {
          this.leaves[this.k].classList.add('is-turned');
          this.k += 1;
        } else if (step < 0 && this.k > 0) {
          this.k -= 1;
          this.leaves[this.k].classList.remove('is-turned');
        }
        this.order();
      }

      order() {
        const n = this.leaves.length;
        this.leaves.forEach((leaf, i) => {
          leaf.style.zIndex = i < this.k ? String(i + 1) : String(n * 2 - i);
        });
        if (this.count) this.count.textContent = this.label.replace('{n}', String(this.start + Math.min(this.k, n - 1) + (this.k === n ? 1 : 0)));
      }
    }
    customElements.define('book-spread', BookSpread);
  }
{% endjavascript %}

{% stylesheet %}
  .book__pages {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: max(380px, calc(var(--d) * 30 * var(--book-scale, 1)));
    perspective: calc(var(--d) * 180);
  }
  .book__page {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(20px, 3vw, 44px);
    background: #fdfdfc;
    color: #121212;
  }
  .book__page--left {
    background: linear-gradient(90deg, #fdfdfc 0%, #fbfbfa 86%, #ececea 100%);
    box-shadow: calc(var(--d) * -0.6) var(--d) calc(var(--d) * 2) calc(var(--d) * -1.4) rgb(0 0 0 / 0.3);
  }
  .book__page--right {
    background: linear-gradient(90deg, #e9e9e7 0%, #f7f7f6 12%, #fdfdfc 30%);
    box-shadow: calc(var(--d) * 0.6) var(--d) calc(var(--d) * 2) calc(var(--d) * -1.4) rgb(0 0 0 / 0.3);
  }
  .book__leaf {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    transform-origin: 0 50%;
    transform-style: preserve-3d;
    transition: transform 1.1s cubic-bezier(0.45, 0.05, 0.2, 1);
    cursor: pointer;
  }
  [dir='rtl'] .book__leaf {
    right: auto;
    left: 0;
    transform-origin: 100% 50%;
  }
  .book__leaf.is-turned {
    transform: rotateY(-180deg);
  }
  [dir='rtl'] .book__leaf.is-turned {
    transform: rotateY(180deg);
  }
  .book__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: clamp(20px, 3vw, 44px);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .book__face--back {
    transform: rotateY(180deg);
  }
  .book__plate {
    display: grid;
    justify-items: center;
    gap: calc(var(--d) * 0.9);
    margin: 0;
  }
  .book__plate img,
  .book__plate .painting-art {
    display: block;
    max-width: min(100%, calc(var(--d) * 22 * var(--plate-scale, 1)));
    max-height: max(200px, min(calc(var(--d) * 22 * var(--plate-scale, 1)), calc(max(380px, var(--d) * 30 * var(--book-scale, 1)) - 120px)));
    width: auto;
    height: auto;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }
  .book__plate .painting-art {
    width: calc(var(--d) * 17.6 * var(--plate-scale, 1));
    height: calc(var(--d) * 22 * var(--plate-scale, 1));
  }
  .book__plate figcaption,
  .book__no {
    font-size: calc(var(--d) * 0.72 * var(--text-scale, 1));
    letter-spacing: 0.08em;
    color: #6d6d6d;
  }
  .book__text {
    display: grid;
    gap: calc(var(--d) * 0.7);
    width: min(100%, calc(var(--d) * 26));
  }
  .book__title {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    font-size: calc(var(--d) * 3.4 * var(--heading-scale, 1) * var(--title-scale, 1));
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .book__title a {
    color: inherit;
    text-decoration: none;
  }
  .book__by {
    margin: 0;
    font-size: calc(var(--d) * 0.88 * var(--text-scale, 1));
    color: #3e3e3e;
  }
  .book__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: calc(var(--d) * 16.4);
    padding-top: 0.8em;
    border-top: 1px solid #e4e4e4;
    font-size: calc(var(--d) * 0.82 * var(--text-scale, 1));
  }
  .book__go {
    justify-self: start;
    margin-top: 0.4em;
    padding-bottom: 0.2em;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-size: calc(var(--d) * 0.82 * var(--text-scale, 1));
    text-decoration: none;
  }
  .book__end {
    display: grid;
    justify-items: center;
    gap: calc(var(--d) * 0.6);
    text-align: center;
  }
  .book__end-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: calc(var(--d) * 2.4 * var(--title-scale, 1));
    line-height: 1;
  }
  .book__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.6em;
    margin-top: calc(var(--d) * 1.4);
    font-size: calc(var(--d) * 0.78 * var(--text-scale, 1));
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .book__arrow {
    width: max(32px, 2.6em);
    height: max(32px, 2.6em);
    border: 1px solid #dadad8;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    cursor: pointer;
  }
  .book:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 6px;
  }
  .book__phone {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .book__leaf {
      transition-duration: 0.01s;
    }
  }
  @media (max-width: 749px) {
    .book__pages,
    .book__nav {
      display: none;
    }
    .book--empty .book__pages {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      height: auto;
    }
    .book__phone {
      display: flex;
      gap: 14px;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter);
      list-style: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .book__phone-page {
      flex: 0 0 82%;
      display: grid;
      gap: 18px;
      padding: 22px;
      background: #fdfdfc;
      color: #121212;
      box-shadow: 0 12px 24px -18px rgb(0 0 0 / 0.35);
      scroll-snap-align: center;
    }
    .book__phone .book__title {
      font-size: calc(1.9rem * var(--title-scale, 1));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Turn of the page",
  "tag": "div",
  "class": "book-spread-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Small title", "default": "The collection" },
    { "type": "collection", "id": "collection", "label": "Paintings from" },
    { "type": "range", "id": "limit", "label": "Pages", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "number", "id": "plate_start", "label": "First plate number", "default": 1 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "heading_size", "label": "Small title size", "min": 70, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "book_height", "label": "Book height", "min": 70, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "painting_size", "label": "Painting size", "min": 60, "max": 150, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "title_size", "label": "Painting name size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 70, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Spacing" },
    {
      "type": "select",
      "id": "padding_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "presets": [{ "name": "Turn of the page" }]
}
{% endschema %}
