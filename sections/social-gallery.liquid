<section data-align="{{ section.settings.sec_text_align }}" data-pad
  class="section color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <div class="page-width">
    <div class="social-gallery__header">
      {%- if section.settings.show_icon -%}
        {% render 'icon', icon: 'instagram', class: 'social-gallery__icon' %}
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        {%- if section.settings.link != blank -%}
          <a class="social-gallery__handle" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.handle | escape }}</a>
        {%- else -%}
          <span class="social-gallery__handle">{{ section.settings.handle | escape }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    <ul class="social-gallery" role="list" style="--gallery-cols: {{ section.settings.columns }};">
      {% content_for 'blocks' %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .social-gallery__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    margin-bottom: 32px;
  }
  .social-gallery__icon {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
  }
  .social-gallery__handle {
    font-size: calc(0.8125rem * var(--sec-t, 1));
    font-weight: 600;
    letter-spacing: var(--label-ls);
    text-transform: var(--label-case);
    color: var(--color-muted);
  }
  .social-gallery {
    display: grid;
    grid-template-columns: repeat(var(--gallery-cols), minmax(0, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social-gallery__item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--tint-1);
  }
  .social-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s ease;
  }
  .social-gallery__link {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(0 0 0 / 0.32);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .social-gallery__link .icon {
    width: 28px;
    height: 28px;
  }
  .social-gallery__item:hover img {
    scale: 1.06;
  }
  .social-gallery__item:hover .social-gallery__link,
  .social-gallery__link:focus-visible {
    opacity: 1;
  }
  @media (max-width: 749px) {
    .social-gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .social-gallery__item {
      flex: 0 0 42%;
      scroll-snap-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social gallery",
  "tag": "div",
  "class": "social-gallery-section",
  "max_blocks": 10,
  "blocks": [{ "type": "_gallery-image" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_icon", "label": "Show Instagram icon", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow our journey" },
    { "type": "text", "id": "handle", "label": "Handle", "info": "For example @yourstore" },
    { "type": "url", "id": "link", "label": "Profile link" },
    { "type": "range", "id": "columns", "label": "Photos per row on desktop", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" },
        { "type": "_gallery-image" }
      ]
    }
  ]
}
{% endschema %}
