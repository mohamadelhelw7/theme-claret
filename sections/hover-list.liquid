<section data-align="{{ section.settings.sec_text_align }}" data-pad
  class="section color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <hover-list class="page-width hover-list hover-list--{{ section.settings.alignment }} hover-list--{{ section.settings.size }} hover-list--{{ section.settings.photo_shape }}">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      description: section.settings.description,
      alignment: section.settings.header_alignment
    %}
    <ul class="hover-list__items" role="list">
      {% content_for 'blocks' %}
    </ul>
    <div class="hover-list__float" aria-hidden="true" data-hover-float></div>
  </hover-list>
</section>

{% stylesheet %}
  hover-list {
    display: block;
  }
  .hover-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  .hover-link {
    border-bottom: 1px solid var(--color-border);
    transition: opacity 0.35s ease;
  }
  .hover-list__items:hover .hover-link:not(:hover) {
    opacity: 0.35;
  }
  .hover-link__anchor {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-block: clamp(14px, 2.2vw, 26px);
    text-decoration: none;
    color: var(--color-text);
  }
  .hover-list--center .hover-link__anchor {
    justify-content: center;
  }
  .hover-link__anchor:hover {
    color: var(--color-text);
  }
  .hover-link__label {
    font-family: var(--font-heading);
    font-stretch: var(--heading-stretch, 100%);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--heading-ls);
    text-transform: var(--heading-case);
    line-height: 1.05;
    transition: translate 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hover-list--large .hover-link__label {
    font-size: calc(clamp(2.25rem, 6vw, 5.5rem) * var(--heading-scale) * var(--sec-h, 1));
  }
  .hover-list--medium .hover-link__label {
    font-size: calc(clamp(1.75rem, 4vw, 3.5rem) * var(--heading-scale) * var(--sec-h, 1));
  }
  .hover-link:hover .hover-link__label {
    translate: 14px 0;
    font-style: italic;
  }
  .heading-accent-color .hover-link:hover .hover-link__label {
    font-style: normal;
    color: var(--color-accent);
  }
  [dir='rtl'] .hover-link:hover .hover-link__label {
    translate: -14px 0;
  }
  .hover-link__count {
    font-size: calc(0.8125rem * var(--sec-t, 1));
    color: var(--color-muted);
    align-self: flex-start;
    margin-top: 0.6em;
  }
  .hover-link__arrow {
    margin-inline-start: auto;
    opacity: 0;
    translate: -10px 0;
    transition: opacity 0.3s, translate 0.3s;
  }
  .hover-list--center .hover-link__arrow {
    display: none;
  }
  .hover-link__arrow .icon {
    width: 28px;
    height: 28px;
  }
  .hover-link:hover .hover-link__arrow {
    opacity: 1;
    translate: 0 0;
  }
  .hover-link__thumb {
    display: none;
    flex: none;
    width: 56px;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-surface);
  }
  .hover-link__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hover-list--arch .hover-link__thumb,
  .hover-list--arch .hover-list__float {
    border-radius: 999px 999px var(--radius-sm) var(--radius-sm);
  }
  .hover-list--rounded .hover-link__thumb,
  .hover-list--rounded .hover-list__float {
    border-radius: var(--radius-lg);
  }
  .hover-list__float {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 4;
    width: clamp(180px, 17vw, 270px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.7;
    transform: translate3d(var(--x, 0), var(--y, 0), 0) translate(-50%, -50%) rotate(var(--tilt, 0deg));
    transition: opacity 0.3s ease, scale 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  .hover-list__float.is-visible {
    opacity: 1;
    scale: 1;
  }
  .hover-list__float img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hover-link__thumb {
      display: block;
    }
    .hover-list__float {
      display: none;
    }
    .hover-link__arrow {
      opacity: 1;
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hover list",
  "tag": "div",
  "class": "hover-list-section",
  "max_blocks": 10,
  "blocks": [{ "type": "_hover-link" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "On desktop, each link's photo follows the pointer. On phones the photo shows as a small thumbnail." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "inline_richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading layout",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "split", "label": "Split with accent line" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Link alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Link size",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "photo_shape",
      "label": "Photo shape",
      "options": [
        { "value": "square", "label": "Square corners" },
        { "value": "rounded", "label": "Rounded corners" },
        { "value": "arch", "label": "Arched top" }
      ],
      "default": "arch"
    },
    { "type": "checkbox", "id": "show_counts", "label": "Show product counts", "info": "For links that use a collection", "default": true },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [
    {
      "name": "Hover list",
      "blocks": [
        { "type": "_hover-link", "settings": { "label": "Hoodies" } },
        { "type": "_hover-link", "settings": { "label": "Tees" } },
        { "type": "_hover-link", "settings": { "label": "Bottoms" } },
        { "type": "_hover-link", "settings": { "label": "Caps" } },
        { "type": "_hover-link", "settings": { "label": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
