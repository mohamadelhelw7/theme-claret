<section data-align="{{ section.settings.sec_text_align }}" data-pad class="section color-{{ section.settings.color_scheme }}" style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};">
  <div class="page-width statement" style="--statement-max: {{ section.settings.max_width }}px;">
    <p class="statement__line">
      {% content_for 'blocks' %}
    </p>
  </div>
</section>

{% stylesheet %}
  .statement {
    max-width: var(--statement-max);
    text-align: center;
  }
  .statement__line {
    font-family: var(--font-heading);
    font-stretch: var(--heading-stretch, 100%);
    font-weight: var(--font-heading-weight);
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .statement__text em {
    font-style: italic;
    color: var(--color-accent);
  }
  .statement__pill {
    display: inline-block;
    width: 2.1em;
    height: 1em;
    border-radius: 999px;
    background: var(--pill-bg);
    vertical-align: middle;
    overflow: hidden;
    margin-inline: 0.08em;
    position: relative;
    top: -0.05em;
  }
  .statement__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statement",
  "tag": "div",
  "class": "statement-section",
  "blocks": [
    {
      "type": "_statement-text"
    },
    {
      "type": "_statement-pill"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 1320,
      "step": 20,
      "unit": "px",
      "default": 1100
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ],
  "presets": [
    {
      "name": "Statement",
      "blocks": [
        {
          "type": "_statement-text",
          "settings": {
            "text": "Fewer pieces,"
          }
        },
        {
          "type": "_statement-pill",
          "settings": {
            "color": "#EAD9CF"
          }
        },
        {
          "type": "_statement-text",
          "settings": {
            "text": "chosen with care, and a home that"
          }
        },
        {
          "type": "_statement-pill",
          "settings": {
            "color": "#DCE1D2"
          }
        },
        {
          "type": "_statement-text",
          "settings": {
            "text": "feels like yours"
          }
        },
        {
          "type": "_statement-pill",
          "settings": {
            "color": "#C9B8A6"
          }
        }
      ]
    }
  ]
}
{% endschema %}
