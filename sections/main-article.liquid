<article data-align="{{ section.settings.sec_text_align }}" data-pad class="section color-{{ section.settings.color_scheme }}" style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};">
  <div class="page-width main-article">
    <header class="page-title-block">
      <a href="{{ blog.url }}" class="eyebrow main-article__back">{{ blog.title | escape }}</a>
      <h1 class="h1">{{ article.title | escape }}</h1>
      <p class="page-title-block__desc">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
        {%- if section.settings.show_author %} · {{ article.author }}{% endif -%}
      </p>
    </header>
    {%- if article.image -%}
      <div class="main-article__media media-tile">
        {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '600, 1000, 1400, 2000', sizes: '(min-width: 1100px) 1000px, 100vw', alt: article.image.alt | escape }}
      </div>
    {%- endif -%}
    <div class="main-article__content rte">{{ article.content }}</div>
  </div>
</article>

{% stylesheet %}
  .main-article {
    max-width: 1048px;
  }
  .main-article__back {
    text-decoration: none;
    margin-bottom: 8px;
  }
  .main-article__media {
    aspect-ratio: 16 / 9;
    margin-bottom: 40px;
  }
  .main-article__content {
    max-width: 720px;
    margin-inline: auto;
    color: var(--color-body);
    line-height: 1.75;
    font-size: calc(1.0625rem * var(--sec-t, 1));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog post",
  "tag": "div",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {"type":"header","content":"Text"},
    {"type":"select","id":"sec_text_align","label":"Text alignment","info":"Headings, text, labels and buttons. Mirrors on Arabic pages.","options":[{"value":"default","label":"As designed"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"sec_heading_font","label":"Heading font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"select","id":"sec_text_font","label":"Text font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"}
  ]
}
{% endschema %}
