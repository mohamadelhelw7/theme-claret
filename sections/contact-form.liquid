<div data-pad class="section color-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};">
  <div class="page-width contact">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact__row">
        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.name' | t }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="field__input" type="email" id="ContactEmail" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
        </div>
      </div>
      <div class="field">
        <label class="field__label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
        <input class="field__input" type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
      </div>
      <div class="field">
        <label class="field__label" for="ContactBody">{{ 'contact.message' | t }}</label>
        <textarea class="field__input" id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
      </div>
      <button type="submit" class="button button--primary">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .contact {
    max-width: 808px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }
  .contact__form .field {
    width: 100%;
  }
  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    width: 100%;
  }
  @media (max-width: 749px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Send us a message"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
