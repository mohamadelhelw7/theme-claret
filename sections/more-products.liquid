{%- liquid
  assign source = section.settings.collection
  if source == blank and product != blank
    for c in product.collections
      if c.handle != 'all' and c.handle != 'frontpage'
        assign source = c
        break
      endif
    endfor
  endif
  if source == blank
    assign source = collections.all
  endif
  assign heading = section.settings.heading | replace: '[collection]', source.title
  assign is_slider = false
  if section.settings.layout == 'slider'
    assign is_slider = true
  endif
  assign shown = 0
-%}

{%- capture cards -%}
  {%- for item in source.products -%}
    {%- if product != blank and item.id == product.id -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    <li>{% render 'product-card', product: item, index: shown %}</li>
    {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <section data-pad
    class="section color-{{ section.settings.color_scheme }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
  >
    <card-slider class="page-width">
      <div class="section-header{% if section.settings.header_alignment == 'center' %} section-header--center{% endif %}">
        <div class="section-header__titles">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2 class="h2">{{ heading | escape }}</h2>
        </div>
        {%- if is_slider and section.settings.header_alignment != 'center' -%}
          {% render 'slider-buttons' %}
        {%- elsif section.settings.show_link -%}
          <a href="{{ source.url }}" class="link-underline">{{ 'sections.more_products.view_all' | t }}</a>
        {%- endif -%}
      </div>
      <ul
        class="{% if is_slider %}slider-track{% else %}product-grid{% endif %}"
        role="list"
        style="--slider-cols: {{ section.settings.columns }}; --cols-desktop: {{ section.settings.columns }}; --cols-mobile: 2;"
        {% if is_slider %}
          data-slider-track
        {% endif %}
      >
        {{ cards }}
      </ul>
    </card-slider>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "More products",
  "tag": "div",
  "class": "more-products-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from [collection]", "info": "[collection] is replaced with the collection name" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "On product pages, leave empty to use the product's own collection"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "slider", "label": "Slider with arrows" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "slider"
    },
    { "type": "range", "id": "columns", "label": "Products per row on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "show_link", "label": "Show View all link", "info": "Shown when the layout is a grid", "default": true },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "More products" }]
}
{% endschema %}
