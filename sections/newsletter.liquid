{%- liquid
  assign form_id = 'NewsletterForm-' | append: section.id
  assign email_id = 'NewsletterEmail-' | append: section.id
-%}

<section data-pad
  class="section color-{{ section.settings.color_scheme }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <div class="page-width newsletter newsletter--{{ section.settings.layout }}">
    {%- if section.settings.layout == 'split' -%}
      <div class="newsletter__media media-curtain{% if section.settings.arch %} media-arch{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 40vw, 100vw', loading: 'lazy', alt: ''
          }}
        {%- else -%}
          {% render 'media-placeholder', kind: 'lifestyle', index: 3 %}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="newsletter__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1 newsletter__heading">{% render 'accent-text', text: section.settings.heading %}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="newsletter__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__message" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="newsletter__message newsletter__message--error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
          <div class="newsletter__row">
            <label for="{{ email_id }}" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
            <input
              id="{{ email_id }}"
              type="email"
              name="contact[email]"
              class="field__input newsletter__input"
              value="{{ form.email }}"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
            <button type="submit" class="button button--primary">{{ 'newsletter.button' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .newsletter {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .newsletter--center {
    justify-items: center;
    text-align: center;
  }
  .newsletter--split {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
  }
  .newsletter__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .newsletter__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .newsletter__content {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 620px;
  }
  .newsletter--center .newsletter__content {
    align-items: center;
  }
  .newsletter__text {
    color: var(--color-body);
  }
  .newsletter__form {
    width: 100%;
  }
  .newsletter__row {
    display: flex;
    gap: 10px;
  }
  .newsletter__input {
    flex: 1;
    min-width: 0;
  }
  .newsletter__message {
    font-size: calc(0.9375rem * var(--sec-t, 1));
  }
  .newsletter__message--error {
    color: var(--color-sale);
  }
  @media (max-width: 749px) {
    .newsletter--split {
      grid-template-columns: 1fr;
    }
    .newsletter__media {
      aspect-ratio: 4 / 3;
    }
    .newsletter__row {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "class": "newsletter-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "split", "label": "Photo beside the form" }
      ],
      "default": "split"
    },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "checkbox", "id": "arch", "label": "Arched photo", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to see new arrivals" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join our list to hear about new collections first.</p>" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "size_heading", "label": "Heading size", "min": 60, "max": 160, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "size_text", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
