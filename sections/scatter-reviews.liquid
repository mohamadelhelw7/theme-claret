<section data-align="{{ section.settings.sec_text_align }}" data-pad
  class="section scatter-reviews color-{{ section.settings.color_scheme }}"
  style="{%- if section.settings.sec_heading_font != 'default' %} --font-heading: var(--ff-{{ section.settings.sec_heading_font }});{% endif -%}{%- if section.settings.sec_text_font != 'default' %} --font-body: var(--ff-{{ section.settings.sec_text_font }});{% endif %} --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --sec-h: {{ section.settings.size_heading | divided_by: 100.0 }}; --sec-t: {{ section.settings.size_text | divided_by: 100.0 }};"
>
  <div class="page-width">
    {%- render 'section-header', heading: section.settings.heading, description: section.settings.description, alignment: 'split' -%}
  </div>
  <scroll-progress class="scatter-reviews__track{% if section.settings.spread %} scatter-reviews__track--spread{% endif %}" data-static-progress="1" data-no-reveal>
    <div class="scatter-reviews__stage">
      <scatter-cards class="page-width scatter-reviews__wall">
        <ul class="scatter-reviews__list" role="list">
          {% content_for 'blocks' %}
        </ul>
      </scatter-cards>
    </div>
  </scroll-progress>
</section>

{% javascript %}
  class ScatterCards extends HTMLElement {
    connectedCallback() {
      this.measure = this.measure.bind(this);
      if ('ResizeObserver' in window) {
        this.observer = new ResizeObserver(() => requestAnimationFrame(this.measure));
        this.observer.observe(this);
      }
      this.measure();
      document.addEventListener('shopify:block:select', this.measure);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      document.removeEventListener('shopify:block:select', this.measure);
    }

    measure() {
      const cards = Array.from(this.querySelectorAll('[data-scatter-card]'));
      if (!cards.length) return;
      const list = this.querySelector('.scatter-reviews__list');
      const cx = list.offsetWidth / 2;
      const cy = list.offsetHeight / 2;
      cards.forEach((card) => {
        const x = card.offsetLeft + card.offsetWidth / 2;
        const y = card.offsetTop + card.offsetHeight / 2;
        card.style.setProperty('--cx', `${(cx - x).toFixed(1)}px`);
        card.style.setProperty('--cy', `${(cy - y).toFixed(1)}px`);
      });
    }
  }
  if (!customElements.get('scatter-cards')) customElements.define('scatter-cards', ScatterCards);
{% endjavascript %}

{% stylesheet %}
  scatter-cards {
    display: block;
  }
  .scatter-reviews__track {
    display: block;
  }
  .scatter-reviews__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scatter-card {
    --r: 0deg;
    position: relative;
    display: grid;
    min-height: 300px;
    overflow: hidden;
    border-radius: var(--radius-md);
    color: #ffffff;
    isolation: isolate;
  }
  .scatter-card:nth-child(3n + 2) {
    translate: 0 6%;
  }
  .scatter-card--r1 { --r: -7deg; }
  .scatter-card--r2 { --r: 4deg; }
  .scatter-card--r3 { --r: -3deg; }
  .scatter-card--r4 { --r: 6deg; }
  .scatter-card--r5 { --r: -5deg; }
  .scatter-card--r6 { --r: 3deg; }
  .scatter-card__media,
  .scatter-card__media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scatter-card__media {
    z-index: -1;
    background: var(--color-surface);
  }
  .scatter-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.1) 70%);
  }
  .scatter-card__body {
    align-self: end;
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 22px;
  }
  .scatter-card__body .stars {
    color: #ffffff;
  }
  .scatter-card__quote {
    margin: 0;
    font-size: calc(0.875rem * var(--sec-t, 1));
    font-weight: 500;
    line-height: 1.55;
  }
  .scatter-card__name {
    display: grid;
    gap: 2px;
    font-size: calc(0.6875rem * var(--sec-t, 1));
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .scatter-card__name a {
    color: inherit;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    opacity: 0.85;
  }

  /* Cards start in a pile in the middle and spread into place */
  @media (min-width: 750px) and (prefers-reduced-motion: no-preference) {
    .scatter-reviews__track--spread {
      --spread: clamp(0, calc((var(--p, 0) - 0.12) / 0.55), 1);
      height: 190vh;
    }
    .scatter-reviews__track--spread .scatter-reviews__stage {
      position: sticky;
      top: 0;
      display: grid;
      align-items: center;
      min-height: 100svh;
      padding-block: calc(var(--header-height, 0px) + 16px) 24px;
    }
    .scatter-reviews__track--spread .scatter-card {
      min-height: min(36svh, 340px);
      translate: calc(var(--cx, 0px) * (1 - var(--spread))) calc(var(--cy, 0px) * (1 - var(--spread)));
      rotate: calc(var(--r) * (1 - var(--spread)));
      scale: calc(0.86 + var(--spread) * 0.14);
      box-shadow: 0 24px 50px -20px rgb(0 0 0 / calc(0.5 - var(--spread) * 0.3));
    }
    .scatter-reviews__track--spread .scatter-card:nth-child(3n + 2) {
      translate: calc(var(--cx, 0px) * (1 - var(--spread))) calc(var(--cy, 0px) * (1 - var(--spread)) + var(--spread) * 6%);
    }
    .scatter-reviews__track--spread.is-static {
      height: auto;
    }
  }

  @media (max-width: 749px) {
    .scatter-reviews__list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .scatter-reviews__list::-webkit-scrollbar {
      display: none;
    }
    .scatter-card {
      flex: 0 0 84%;
      scroll-snap-align: start;
      min-height: 360px;
    }
    .scatter-card:nth-child(3n + 2) {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
