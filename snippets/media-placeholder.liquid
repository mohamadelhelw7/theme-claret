{% doc %}
  Fills a frame that has no image yet with a simple painting in the theme's drawing colors: a landscape,
  a portrait, a flowering branch or an abstract, chosen by position. Wide frames (heroes, collections,
  lifestyle and video) get a wide landscape. Theme settings → Layout → Missing photos can switch it to a
  plain tint. Inside the theme editor it also shows an "Add an image" hint, which shoppers never see.

  @param {string} [kind] - product (default), article, collection, hero, lifestyle or video
  @param {number} [index] - Position in a list, used to vary the painting
  @param {string} [label] - A product or collection name, kept on the frame as a data attribute

  @example
  {% render 'media-placeholder', kind: 'product', index: forloop.index, label: product.title %}
{% enddoc %}

{%- liquid
  assign ph_kind = kind | default: 'product'
  assign ph_index = index | default: 1 | plus: 0
  assign ph_wide = false
  if ph_kind == 'hero' or ph_kind == 'lifestyle' or ph_kind == 'collection' or ph_kind == 'video'
    assign ph_wide = true
  endif
  assign ph_variant = ph_index | modulo: 4 | plus: 1
-%}

{%- if settings.placeholder_style == 'plain' -%}
  <span class="media-placeholder" aria-hidden="true">
    {%- if request.design_mode -%}
      <span class="media-placeholder__hint">{{ 'general.placeholder.image' | t }}</span>
    {%- endif -%}
  </span>
{%- else -%}
  <span data-label="{{ label | escape }}" class="media-placeholder media-placeholder--art" aria-hidden="true">
    {% render 'painting-art', variant: ph_variant, wide: ph_wide %}
    {%- if request.design_mode -%}
      <span class="media-placeholder__hint">{{ 'general.placeholder.image' | t }}</span>
    {%- endif -%}
  </span>
{%- endif -%}

{% stylesheet %}
  :where(.media-placeholder) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg));
  }
  .media-placeholder--art .painting-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .media-placeholder__hint {
    position: relative;
    z-index: 1;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.85);
    color: #1a1a1a;
    font-size: calc(0.75rem * var(--sec-t, 1));
    font-weight: 500;
  }
{% endstylesheet %}
