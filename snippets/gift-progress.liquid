{% doc %}
  The Buy 2, get 1 free progress bar, from Art Cellar's Atelier theme, in Claret's look: a message, then a line
  with a step for each painting and a gift at the end. It counts the paintings in the cart (products listed under
  Products that don't count are left out) and starts again after each free one. It only shows progress: the real
  discount comes from an automatic discount in Shopify admin. Settings are in Theme settings → Cart.

  @param {string} [place] - drawer or page

  @example
  {% render 'gift-progress', place: 'drawer' %}
{% enddoc %}

{%- liquid
  assign gp_show = settings.gift_enable
  if place == 'page' and settings.gift_show_page == false
    assign gp_show = false
  endif
  assign gp_exclude = settings.gift_exclude | downcase | remove: ' ' | split: ','
  assign gp_count = 0
  for item in cart.items
    unless gp_exclude contains item.product.handle
      assign gp_count = gp_count | plus: item.quantity
    endunless
  endfor
  if gp_count == 0 and settings.gift_show_empty == false
    assign gp_show = false
  endif
  assign gp_buy = settings.gift_buy | default: 2
  assign gp_get = settings.gift_get | default: 1
  assign gp_cycle = gp_buy | plus: gp_get
  assign gp_rem = gp_count | modulo: gp_cycle
  assign gp_free = gp_count | divided_by: gp_cycle | floor | times: gp_get
  assign gp_full = false
  if gp_count > 0 and gp_rem == 0
    assign gp_full = true
  endif
-%}

{%- if gp_show -%}
  {%- liquid
    if gp_full
      assign gp_reached = gp_cycle
      if gp_free == 1
        assign gp_msg = 'cart.gift.unlocked_one' | t
      else
        assign gp_msg = 'cart.gift.unlocked_many' | t | replace: '[n]', gp_free
      endif
      assign gp_msg = '<strong>' | append: gp_msg | append: '</strong>'
    elsif gp_rem < gp_buy
      assign gp_reached = gp_rem
      assign gp_need = gp_buy | minus: gp_rem
      if gp_count == 0
        assign gp_key = 'cart.gift.start_html'
      elsif gp_need == 1
        assign gp_key = 'cart.gift.more_one_html'
      else
        assign gp_key = 'cart.gift.more_many_html'
      endif
      if gp_free > 0
        assign gp_key = gp_key | replace: '_html', '_again_html'
      endif
      assign gp_msg = gp_key | t | replace: '[n]', gp_need | replace: '[get]', gp_get
    else
      assign gp_reached = gp_rem
      if gp_free > 0
        assign gp_msg = 'cart.gift.next_free_again_html' | t
      else
        assign gp_msg = 'cart.gift.next_free_html' | t
      endif
    endif
    if gp_free == 1
      assign gp_badge = 'cart.gift.badge_one' | t
    else
      assign gp_badge = 'cart.gift.badge_many' | t | replace: '[n]', gp_free
    endif
    assign gp_pct = gp_reached | times: 1.0 | divided_by: gp_cycle
  -%}
  <div class="gift-bar gift-bar--{{ place | default: 'drawer' }}" role="status">
    {%- if gp_free > 0 and gp_full == false -%}
      <p class="gift-bar__unlocked">
        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6.2l3 3L10.5 2.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        <span>{{ gp_badge }}</span>
      </p>
    {%- endif -%}
    <p class="gift-bar__msg">
      <svg class="gift-bar__gift" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9"/><path d="M12 8v13"/><path d="M12 8c-1.5-3-5-4-5.5-2S9 8 12 8zM12 8c1.5-3 5-4 5.5-2S15 8 12 8z"/></svg>
      <span>{{ gp_msg }}</span>
    </p>
    <div class="gift-bar__line" style="--gift-pct: {{ gp_pct }};" aria-hidden="true">
      <span class="gift-bar__track"></span>
      <span class="gift-bar__fill"></span>
      {%- for k in (1..gp_cycle) -%}
        <span class="gift-bar__step{% if k <= gp_reached %} is-on{% endif %}" style="--gift-at: {{ k | times: 100.0 | divided_by: gp_cycle }}%;">
          {%- if k == gp_cycle -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9"/><path d="M12 8v13"/><path d="M12 8c-1.5-3-5-4-5.5-2S9 8 12 8zM12 8c1.5-3 5-4 5.5-2S15 8 12 8z"/></svg>
          {%- else -%}
            {{ k }}
          {%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .gift-bar {
    display: block;
    padding: calc(var(--d) * 1) calc(var(--d) * 1.2) calc(var(--d) * 1.1);
    background: var(--wall, #f1f1f0);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: calc(var(--d) * 0.8);
    line-height: 1.5;
  }
  .gift-bar--drawer {
    margin: 16px 24px 4px;
  }
  .gift-bar--page {
    margin: 0 0 24px;
  }
  .gift-bar p {
    margin: 0;
  }
  .gift-bar__unlocked {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px !important;
    font: 500 calc(var(--d) * 0.62) / 1.4 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .gift-bar__msg {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .gift-bar__gift {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
  }
  .gift-bar__msg strong {
    font-weight: 600;
  }
  /* The line: a thin track, the filled part and a round step for each painting, the gift last */
  .gift-bar__line {
    position: relative;
    height: 28px;
    margin: 14px 4px 0;
  }
  .gift-bar__track,
  .gift-bar__fill {
    position: absolute;
    inset-inline-start: 0;
    top: 13px;
    height: 2px;
  }
  .gift-bar__track {
    inset-inline-end: 14px;
    background: color-mix(in srgb, var(--color-text) 12%, transparent);
  }
  .gift-bar__fill {
    width: calc(var(--gift-pct) * 100% - var(--gift-pct) * 14px);
    background: var(--color-text);
    transition: width 0.35s ease;
  }
  .gift-bar__step {
    position: absolute;
    top: 0;
    inset-inline-start: var(--gift-at);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-inline-start: -28px;
    border: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .gift-bar__step svg {
    width: 14px;
    height: 14px;
  }
  .gift-bar__step.is-on {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-bg);
  }
{% endstylesheet %}
