{% doc %}
  One slide of the Full painting hero: a painting or photo that fills the hero, an optional phone image, an
  optional second photo beside it on computers, or a looping video. The credit names the painting and links to it.
{% enddoc %}

{%- liquid
  assign slide_first = false
  if section.blocks.first.id == block.id
    assign slide_first = true
  endif
  assign slide_two = false
  if block.settings.video == blank and block.settings.image != blank and block.settings.image_2 != blank
    assign slide_two = true
  endif
  assign slide_loading = 'lazy'
  assign slide_priority = 'auto'
  if slide_first
    assign slide_loading = 'eager'
    assign slide_priority = 'high'
  endif
  assign slide_sizes = '100vw'
  if slide_two
    assign slide_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign slide_credit = block.settings.credit | remove: '*' | escape
  assign slide_alt = block.settings.image.alt | default: slide_credit
  assign slide_focal = ''
  if block.settings.image != blank
    assign slide_focal = 'object-position: ' | append: block.settings.image.presentation.focal_point | append: ';'
  endif
-%}

<div class="fullp__slide{% if slide_first %} is-on{% endif %}" data-credit="{{ slide_credit }}" data-link="{{ block.settings.link }}" {{ block.shopify_attributes }}>
  <div class="fullp__media{% if slide_two %} fullp__media--two{% endif %}">
    {%- if block.settings.video != blank -%}
      {{ block.settings.video | video_tag: autoplay: slide_first, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'fullp__img' }}
    {%- elsif block.settings.image != blank -%}
      <picture class="fullp__pic">
        {%- if block.settings.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ block.settings.image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
        {%- endif -%}
        {{ block.settings.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 1920, 2400, 3000', sizes: slide_sizes, loading: slide_loading, fetchpriority: slide_priority, alt: slide_alt, style: slide_focal, class: 'fullp__img' }}
      </picture>
      {%- if slide_two -%}
        {%- assign slide_alt_2 = block.settings.image_2.alt | default: slide_credit -%}
        <picture class="fullp__pic fullp__pic--second">
          {{ block.settings.image_2 | image_url: width: 1600 | image_tag: widths: '750, 1100, 1600', sizes: '50vw', loading: slide_loading, alt: slide_alt_2, class: 'fullp__img' }}
        </picture>
      {%- endif -%}
    {%- else -%}
      {% render 'media-placeholder', kind: 'hero' %}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Slide",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Painting or photo", "info": "Fills the hero. Set the focal point in the image picker to keep the important part in view on phones." },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "Optional, shown on phones instead" },
    { "type": "image_picker", "id": "image_2", "label": "Second photo", "info": "Optional. Shows beside the first on computers, so the slide holds two photos" },
    { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on a loop instead of the photos" },
    { "type": "text", "id": "credit", "label": "Credit", "info": "Shown at the top, for example Claude Monet · Woman with a Parasol, 1875" },
    { "type": "url", "id": "link", "label": "Credit link", "info": "For example the painting's product page" }
  ]
}
{% endschema %}
