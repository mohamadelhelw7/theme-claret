{% doc %}
  Renders a group of expandable rows. Optionally only one row can be open at a time.

  @example
  {% content_for 'block', type: 'accordion', id: 'accordion' %}
{% enddoc %}

<div style="--bmt: {{ block.settings.block_pt }}px; --bmb: {{ block.settings.block_pb }}px;{% if block.settings.block_font != 'default' %} --font-heading: var(--ff-{{ block.settings.block_font }}); --font-body: var(--ff-{{ block.settings.block_font }});{% endif %}" data-align="{{ block.settings.block_align }}"
  class="accordion accordion--{{ block.settings.style }}"
  data-accordion-name="{% if block.settings.single_open %}accordion-{{ block.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="accordion__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}
  {% content_for 'blocks' %}
</div>

{% javascript %}
  document.querySelectorAll('[data-accordion-name]').forEach((group) => {
    const name = group.dataset.accordionName;
    if (!name) return;
    group.querySelectorAll(':scope > details').forEach((row) => row.setAttribute('name', name));
  });
  document.addEventListener('shopify:section:load', (event) => {
    event.target.querySelectorAll('[data-accordion-name]').forEach((group) => {
      const name = group.dataset.accordionName;
      if (!name) return;
      group.querySelectorAll(':scope > details').forEach((row) => row.setAttribute('name', name));
    });
  });
{% endjavascript %}

{% stylesheet %}
  .accordion__heading {
    font-size: calc(0.875rem * var(--sec-t, 1));
    font-weight: 600;
    margin-bottom: 8px;
  }
  .accordion--lines .accordion-row {
    border-top: 1px solid var(--color-border);
  }
  .accordion--lines .accordion-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .accordion--cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .accordion--cards .accordion-row {
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    padding-inline: 18px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Accordion",
  "tag": null,
  "blocks": [{ "type": "_accordion-row" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "lines", "label": "Lines" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "lines"
    },
    { "type": "checkbox", "id": "single_open", "label": "Only one row open at a time", "default": true },
    {"type":"header","content":"Text"},
    {"type":"select","id":"block_align","label":"Alignment","info":"Only this block. Mirrors on Arabic pages.","options":[{"value":"default","label":"As the section"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"block_font","label":"Font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"header","content":"Padding"},
    {"type":"range","id":"block_pt","label":"Top","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"range","id":"block_pb","label":"Bottom","min":0,"max":120,"step":4,"unit":"px","default":0}
  ],
  "presets": [
    {
      "name": "Accordion",
      "category": "Text",
      "blocks": [
        { "type": "_accordion-row", "settings": { "heading": "How to use", "icon": "drop" } },
        { "type": "_accordion-row", "settings": { "heading": "Materials and care", "icon": "gem" } },
        { "type": "_accordion-row", "settings": { "heading": "Shipping and returns", "icon": "truck" } }
      ]
    }
  ]
}
{% endschema %}
