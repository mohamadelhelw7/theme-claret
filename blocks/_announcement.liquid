{% doc %}
  Renders one announcement message inside the announcement bar.

  @example
  {% content_for 'block', type: '_announcement', id: 'announcement' %}
{% enddoc %}

{%- if block.settings.text != blank -%}
  <span class="announcement" {{ block.shopify_attributes }}>
    {%- if block.settings.link != blank -%}
      <a href="{{ block.settings.link }}">{% render 'accent-text', text: block.settings.text %}</a>
    {%- else -%}
      {% render 'accent-text', text: block.settings.text %}
    {%- endif -%}
  </span>
{%- endif -%}

{% stylesheet %}
  .announcement a {
    color: inherit;
    text-decoration: none;
  }
  .announcement a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .announcement em {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.25em;
    line-height: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement",
  "tag": null,
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "info": "Put *asterisks* around words to set them in italic serif", "default": "The new collection is here" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
