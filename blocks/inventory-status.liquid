{% doc %}
  Renders a stock status line for the selected variant and updates on variant change.

  @example
  {% content_for 'block', type: 'inventory-status', id: 'inventory' %}
{% enddoc %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
<div style="--bmt: {{ block.settings.block_pt }}px; --bmb: {{ block.settings.block_pb }}px;{% if block.settings.block_font != 'default' %} --font-heading: var(--ff-{{ block.settings.block_font }}); --font-body: var(--ff-{{ block.settings.block_font }});{% endif %}" data-align="{{ block.settings.block_align }}" class="inventory-status" data-update="inventory-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if current_variant.inventory_management == 'shopify' -%}
    {%- liquid
      assign qty = current_variant.inventory_quantity
      assign state = 'in'
      if qty <= 0
        if current_variant.available
          assign state = 'backorder'
        else
          assign state = 'out'
        endif
      elsif qty <= block.settings.low_threshold
        assign state = 'low'
      endif
    -%}
    <p class="inventory-status__line inventory-status--{{ state }}">
      <span class="inventory-status__dot" aria-hidden="true"></span>
      {%- case state -%}
        {%- when 'low' -%}
          {%- if block.settings.show_count -%}
            {{ 'products.inventory.low_count' | t: count: qty }}
          {%- else -%}
            {{ 'products.inventory.low' | t }}
          {%- endif -%}
        {%- when 'out' -%}
          {{ 'products.inventory.out' | t }}
        {%- when 'backorder' -%}
          {{ 'products.inventory.backorder' | t }}
        {%- else -%}
          {{ 'products.inventory.in' | t }}
      {%- endcase -%}
    </p>
  {%- elsif current_variant.available -%}
    <p class="inventory-status__line inventory-status--in">
      <span class="inventory-status__dot" aria-hidden="true"></span>
      {{ 'products.inventory.in' | t }}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .inventory-status__line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: calc(0.875rem * var(--sec-t, 1));
    color: var(--color-body);
  }
  .inventory-status__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }
  .inventory-status--low .inventory-status__dot {
    background: #c98a2b;
    box-shadow: 0 0 0 4px rgba(201, 138, 43, 0.18);
  }
  .inventory-status--out .inventory-status__dot {
    background: var(--color-sale);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-sale) 18%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stock status",
  "tag": null,
  "settings": [
    { "type": "range", "id": "low_threshold", "label": "Low stock below", "min": 1, "max": 30, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "show_count", "label": "Show exact count when low", "default": true },
    {"type":"header","content":"Text"},
    {"type":"select","id":"block_align","label":"Alignment","info":"Only this block. Mirrors on Arabic pages.","options":[{"value":"default","label":"As the section"},{"value":"start","label":"Left"},{"value":"center","label":"Center"},{"value":"end","label":"Right"}],"default":"default"},
    {"type":"select","id":"block_font","label":"Font","options":[{"value":"default","label":"As designed"},{"value":"heading","label":"Theme heading font"},{"value":"body","label":"Theme body font"},{"value":"newsreader","label":"Newsreader"},{"value":"red_hat_text","label":"Red Hat Text"},{"value":"instrument_serif","label":"Instrument Serif"},{"value":"inter_tight","label":"Inter Tight"}],"default":"default"},
    {"type":"header","content":"Padding"},
    {"type":"range","id":"block_pt","label":"Top","min":0,"max":120,"step":4,"unit":"px","default":0},
    {"type":"range","id":"block_pb","label":"Bottom","min":0,"max":120,"step":4,"unit":"px","default":0}
  ],
  "presets": [{ "name": "Stock status", "category": "Product" }]
}
{% endschema %}
