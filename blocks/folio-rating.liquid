{% doc %}
  Stars and the number of reviews, linking to the reviews further down. Shows only once a review app has saved
  a rating on the product (the reviews.rating metafield); nothing is made up.

  @example
  {% content_for 'block', type: 'folio-rating', id: 'rating' %}
{% enddoc %}

{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
-%}
{%- if rating != blank -%}
  <div class="frating" data-align="{{ block.settings.block_align }}" style="--bmt: {{ block.settings.block_pt }}px; --bmb: {{ block.settings.block_pb }}px;{% if block.settings.block_font != 'default' %} --font-heading: var(--ff-{{ block.settings.block_font }}); --font-body: var(--ff-{{ block.settings.block_font }});{% endif %} --rating-scale: {{ block.settings.size | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
    <a class="fpro__rating" href="#{{ block.settings.anchor | default: 'reviews' | handleize }}">
      {% render 'stars', rating: rating.rating, scale: rating.scale_max %}
      <span><bdi dir="ltr">{{ rating.rating | round: 1 }}</bdi>{% if block.settings.show_count and rating_count > 0 %} · {{ rating_count }}{% endif %}</span>
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Star rating",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows once your review app saves a rating on the product."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the number of reviews",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Link to",
      "info": "The anchor of the reviews section",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "block_align",
      "label": "Alignment",
      "info": "Only this block. Mirrors on Arabic pages.",
      "options": [
        {
          "value": "default",
          "label": "As the section"
        },
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "block_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "newsreader",
          "label": "Newsreader"
        },
        {
          "value": "red_hat_text",
          "label": "Red Hat Text"
        },
        {
          "value": "instrument_serif",
          "label": "Instrument Serif"
        },
        {
          "value": "inter_tight",
          "label": "Inter Tight"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "block_pt",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "block_pb",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Star rating"
    }
  ]
}
{% endschema %}
