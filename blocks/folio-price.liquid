{% doc %}
  The chosen size's price, in the light serif, updated when the shopper picks another size.

  @example
  {% content_for 'block', type: 'folio-price', id: 'price' %}
{% enddoc %}

{%- assign price_variant = product.selected_or_first_available_variant -%}
<div class="fprice" data-align="{{ block.settings.block_align }}" style="--bmt: {{ block.settings.block_pt }}px; --bmb: {{ block.settings.block_pb }}px;{% if block.settings.block_font != 'default' %} --font-heading: var(--ff-{{ block.settings.block_font }}); --font-body: var(--ff-{{ block.settings.block_font }});{% endif %} --price-scale: {{ block.settings.size | divided_by: 100.0 }}; --price-scale-m: {{ block.settings.size_mobile | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
  <div class="fpro__priceline" data-update="price-{{ block.id }}">
    {% render 'price', variant: price_variant %}
  </div>
  {%- if block.settings.show_tax_note -%}
    <p class="fprice__note">
      {%- if cart.taxes_included -%}
        {{ 'products.product.taxes_included' | t }}
      {%- else -%}
        {{ 'products.product.taxes_excluded' | t }}
      {%- endif -%}
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Painting price",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "Show the tax note",
      "default": false
    },
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 70,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "size_mobile",
      "label": "Size on phones",
      "min": 50,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "block_align",
      "label": "Alignment",
      "info": "Only this block. Mirrors on Arabic pages.",
      "options": [
        {
          "value": "default",
          "label": "As the section"
        },
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "block_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "newsreader",
          "label": "Newsreader"
        },
        {
          "value": "red_hat_text",
          "label": "Red Hat Text"
        },
        {
          "value": "instrument_serif",
          "label": "Instrument Serif"
        },
        {
          "value": "inter_tight",
          "label": "Inter Tight"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "block_pt",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "block_pb",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Painting price"
    }
  ]
}
{% endschema %}
