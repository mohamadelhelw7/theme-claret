{% doc %}
  The painting's name, as the page's main heading. Its own alignment, font, sizes and padding.

  @example
  {% content_for 'block', type: 'folio-title', id: 'title' %}
{% enddoc %}

<div class="ftitle" data-align="{{ block.settings.block_align }}" style="--bmt: {{ block.settings.block_pt }}px; --bmb: {{ block.settings.block_pb }}px;{% if block.settings.block_font != 'default' %} --font-heading: var(--ff-{{ block.settings.block_font }}); --font-body: var(--ff-{{ block.settings.block_font }});{% endif %} --title-scale: {{ block.settings.size | divided_by: 100.0 }}; --title-scale-m: {{ block.settings.size_mobile | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
  <h1 class="fpro__title">{{ product.title | escape }}</h1>
</div>

{% schema %}
{
  "name": "Painting name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Sizes"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 50,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "size_mobile",
      "label": "Size on phones",
      "min": 40,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "select",
      "id": "block_align",
      "label": "Alignment",
      "info": "Only this block. Mirrors on Arabic pages.",
      "options": [
        {
          "value": "default",
          "label": "As the section"
        },
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "block_font",
      "label": "Font",
      "options": [
        {
          "value": "default",
          "label": "As designed"
        },
        {
          "value": "heading",
          "label": "Theme heading font"
        },
        {
          "value": "body",
          "label": "Theme body font"
        },
        {
          "value": "newsreader",
          "label": "Newsreader"
        },
        {
          "value": "red_hat_text",
          "label": "Red Hat Text"
        },
        {
          "value": "instrument_serif",
          "label": "Instrument Serif"
        },
        {
          "value": "inter_tight",
          "label": "Inter Tight"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "block_pt",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "block_pb",
      "label": "Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Painting name"
    }
  ]
}
{% endschema %}
