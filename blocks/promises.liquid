{% doc %}
  Up to three short promises in a row, each with its own thin line icon, for example a textured
  painting feel, a handmade wooden frame and an offer.

  @example
  {% content_for 'block', type: 'promises', id: 'promises' %}
{% enddoc %}

{%- capture promise_items -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign text_key = 'text_' | append: i
      assign icon_key = 'icon_' | append: i
      assign p_text = block.settings[text_key]
      assign p_icon = block.settings[icon_key]
    -%}
    {%- if p_text != blank -%}
      <li class="fpromise">
        <svg class="fpromise__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {%- case p_icon -%}
            {%- when 'texture' -%}
              <rect x="3.5" y="3.5" width="17" height="17"/><path d="M6.5 9c2-1.6 3.6 1.6 5.5 0s3.5 1.6 5.5 0M6.5 13c2-1.6 3.6 1.6 5.5 0s3.5 1.6 5.5 0M6.5 17c2-1.6 3.6 1.6 5.5 0s3.5 1.6 5.5 0"/>
            {%- when 'frame' -%}
              <rect x="3" y="3" width="18" height="18"/><rect x="7" y="7" width="10" height="10"/><path d="M3 3l4 4M21 3l-4 4M3 21l4-4M21 21l-4-4"/>
            {%- when 'offer' -%}
              <rect x="2.5" y="7" width="6" height="8.5"/><rect x="9.5" y="7" width="6" height="8.5"/><path d="M19.5 8.8v5M17 11.3h5"/>
            {%- when 'truck' -%}
              <path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/>
            {%- when 'shield' -%}
              <path d="M12 3l7 3v5c0 4.4-3 8.2-7 10-4-1.8-7-5.6-7-10V6z"/><path d="M9 12l2 2 4-4"/>
            {%- when 'hook' -%}
              <path d="M12 3v3"/><path d="M12 6c-2 0-3 1.5-3 3s1 2 3 2 3 1 3 3-1.5 3-3 3"/><rect x="5" y="15" width="14" height="6"/>
            {%- when 'gift' -%}
              <rect x="4" y="9" width="16" height="11"/><path d="M3 9h18v-3H3zM12 6v14"/><path d="M12 6c-1.5-3-5-3-5-1s3 1 5 1c2 0 5 1 5-1s-3.5-2-5 1"/>
            {%- else -%}
              <path d="M12 3l2.6 5.6 6 .6-4.5 4.1 1.3 6L12 16.4 6.6 19.3l1.3-6L3.4 9.2l6-.6z"/>
          {%- endcase -%}
        </svg>
        <span>{{ p_text | escape }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if promise_items != blank -%}
  <ul class="fpromises" role="list" style="--promise-icon: {{ block.settings.icon_size }}px; --promise-text: {{ block.settings.text_size | divided_by: 100.0 }};" {{ block.shopify_attributes }}>
    {{ promise_items }}
  </ul>
{%- endif -%}

{% stylesheet %}
  .fpromises {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--d);
    margin: 0;
    padding: 6px 0 4px;
    list-style: none;
    text-align: center;
  }
  .fpromise {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.6em;
    font-size: calc(var(--d) * 0.76 * var(--promise-text, 1));
    line-height: 1.35;
  }
  .fpromise__icon {
    width: var(--promise-icon, 28px);
    height: var(--promise-icon, 28px);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.05;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promises",
  "tag": null,
  "settings": [
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 70, "max": 150, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select",
      "id": "icon_1",
      "label": "Icon 1",
      "options": [
        { "value": "texture", "label": "Canvas texture" },
        { "value": "frame", "label": "Frame" },
        { "value": "offer", "label": "Two plus one" },
        { "value": "truck", "label": "Delivery" },
        { "value": "shield", "label": "Shield" },
        { "value": "hook", "label": "Hook" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" }
      ],
      "default": "texture"
    },
    { "type": "text", "id": "text_1", "label": "Promise 1", "default": "Textured painting feel" },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Icon 2",
      "options": [
        { "value": "texture", "label": "Canvas texture" },
        { "value": "frame", "label": "Frame" },
        { "value": "offer", "label": "Two plus one" },
        { "value": "truck", "label": "Delivery" },
        { "value": "shield", "label": "Shield" },
        { "value": "hook", "label": "Hook" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" }
      ],
      "default": "frame"
    },
    { "type": "text", "id": "text_2", "label": "Promise 2", "default": "Handmade wooden frame" },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Icon 3",
      "options": [
        { "value": "texture", "label": "Canvas texture" },
        { "value": "frame", "label": "Frame" },
        { "value": "offer", "label": "Two plus one" },
        { "value": "truck", "label": "Delivery" },
        { "value": "shield", "label": "Shield" },
        { "value": "hook", "label": "Hook" },
        { "value": "gift", "label": "Gift" },
        { "value": "star", "label": "Star" }
      ],
      "default": "offer"
    },
    { "type": "text", "id": "text_3", "label": "Promise 3", "info": "An offer needs a matching automatic discount in Discounts", "default": "Buy 2, get 1 free" }
  ]
}
{% endschema %}
